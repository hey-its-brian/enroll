<% if @bs4 %>
  <%= render 'menu', :active_tab => "home-tab" %>
  <div class="profile-content top-pd">
    <div class="tab-row">
      <div class="tab-content" id="myTabContent">
        <div id="assister_agency_form" class="container agency_form">
          <%= form_for @form_assister_agency_profile, as: :organization, url: profiles_assister_agencies_assister_agency_profile_path(@assister_agency_profile), method: :patch do |f| %>

            <%= f.hidden_field :id %>
            <%= render 'benefit_sponsors/shared/error_messages', :object => @form_assister_agency_profile %>
            <div class="row">
              <%= render "person_info_fields", f: f %>

              <div class="row">
                <div class="col-md-9 col-sm-9 col-xs-12">
                  <h4><%= l10n("assister_agencies.assister_roles.new_assister_agency_form.assister_agency_information") %></h4>
                  <div class="row no-buffer row-form-wrapper">
                    <%= render "benefit_sponsors/shared/organizations/entity_name_and_type_fields", f: f, entity_kinds: Organization::ENTITY_KINDS[0..3], readonly: 'readonly' %>
                  </div>
                  <div class="row no-buffer row-form-wrapper">
                    <div class="col-sm-6 col-xs-12 form-group form-group-lg no-pd">
                      <%= f.text_field :home_page, class: "floatlabel form-control interaction-field-control-assister-home-page", placeholder: "#{l10n('website_url')}" %>
                    </div>
                  </div>
                  <div class="row no-buffer row-form-wrapper">
                    <%= render "benefit_sponsors/shared/assister_agency_profile_fields", f: f, read_only_dropdown: 'read_only_dropdown' %>
                  </div><br>

                  <div class="action-group">
                    <%= render "benefit_sponsors/shared/office_locations", f: f %>
                    <div class="row no-buffer">
                      <button type="submit" class="btn btn-primary pull-right create_assister_agency_btn interaction-click-control-create-assister-agency"><%= l10n("update_assister_agency")%></button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% else %>
  <%= render 'menu', :active_tab => "home-tab" %>
  <div class="profile-content top-pd">
    <div class="tab-row">
      <div class="tab-content" id="myTabContent">
        <div id="assister_agency_form" class="container">
          <%= form_for @form_assister_agency_profile, as: :organization, url: profiles_assister_agencies_assister_agency_profile_path(@assister_agency_profile), method: :patch do |f| %>

            <%= f.hidden_field :id %>
            <%= render 'benefit_sponsors/shared/error_messages', :object => @form_assister_agency_profile %>
            <div class="row">
              <%= render "person_info_fields", f: f %>

              <div class="row">
                <div class="col-md-9 col-sm-9 col-xs-12">
                  <h4>Broker Agency Information</h4>
                  <div class="row no-buffer row-form-wrapper">
                    <%= render "benefit_sponsors/shared/organizations/entity_name_and_type_fields", f: f, entity_kinds: Organization::ENTITY_KINDS[0..3], readonly: 'readonly' %>
                  </div>
                  <div class="row no-buffer row-form-wrapper">
                    <div class="col-sm-6 col-xs-12 form-group form-group-lg no-pd">
                      <%= f.text_field :home_page, class: "floatlabel form-control interaction-field-control-assister-home-page", placeholder: "#{l10n('website_url')}" %>
                    </div>
                  </div>
                  <div class="row no-buffer row-form-wrapper">
                    <%= render "benefit_sponsors/shared/assister_agency_profile_fields", f: f, read_only_dropdown: 'read_only_dropdown' %>
                  </div><br>

                  <div class="action-group">
                    <%= render "benefit_sponsors/shared/office_locations", f: f %>
                    <div class="row no-buffer">
                      <button type="submit" class="btn btn-primary pull-right create_assister_agency_btn interaction-click-control-create-assister-agency"><%= l10n(".update_assister_agency")%></button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>
