<% assister = 'Nothing' %>
<% general_agency = 'Nothing' %>

<%
if employer_datatable_entry.active_assister_agency_account.present? && employer_datatable_entry.memoize_active_assister(@memo)
        assister_agency_profile = employer_datatable_entry.active_assister_agency_account.assister_agency_profile
        edit_path = edit_assister_agencies_profile_applicant_path(assister_agency_profile, employer_datatable_entry.memoize_active_assister(@memo))
        assister = link_to employer_datatable_entry.memoize_active_assister(@memo).full_name, edit_path, class: "interaction-click-control-assister-show", method: :get
end
%>

<%
      if employer_datatable_entry.active_general_agency_account.present?
        ga_legal_name = employer_datatable_entry.hashed_active_general_agency_legal_name(@general_agency_profiles)
        if pundit_span(EmployerProfile, :updateable?)
          clear_assign_path = pundit_span(EmployerProfile, :updateable?) + raw('<br>') + link_to( "#{l10n('clear_assignment')}", clear_assign_for_employer_assister_agencies_profile_path(id: @assister_agency_profile.id, employer_id: employer_datatable_entry.id), method: :post, remote: true, data: {  confirm: l10n("assister_agencies.profiles.remove_general_agency_assignment") })
        end
        general_agency = ga_legal_name + clear_assign_path if ga_legal_name
      end
%>

<% effective_date = employer_datatable_entry.published_plan_year.try(:effective_date).to_s + pundit_span(EmployerProfile, :list_enrollments?) + raw('<br>')  + link_to("(#{l10n('review')})", employers_premium_statement_path(employer_datatable_entry)) %>

<% checkbox_column = capture do %>
  <%= check_box_tag "employer_ids[]", employer_datatable_entry.id, false, :id => "assister_dt_employer_ids_#{employer_datatable_entry.id}" %>
<% end %>

<% legal_name = capture do %>
  <%= link_to employer_datatable_entry.legal_name, employers_employer_profile_path(employer_datatable_entry)+"?tab=home" %>
<% end %>

{
  "nothing": <%= raw checkbox_column.to_json %>,
  "fein": <%= raw employer_datatable_entry.fein.to_json %>,
  "legal_name" : <%= raw legal_name.to_json %>,
  "ee_count": "N/A",
  "er_state": <%= raw employer_datatable_entry.aasm_state.humanize.to_json %>,
  "assister": <%= raw assister.to_json %>,
  "general_agency": <%= raw general_agency.to_json %>,
  "effective_date": <%= raw effective_date.to_json %>
}
