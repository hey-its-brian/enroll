<% if @bs4 %>
<thead>
    <tr class='border-top-0'>
      <th class='col-sm-4'><%= l10n("expert_name")%></th>
      <th class='col-sm-3'><%= l10n("agency_name")%></th>
      <th class='col-sm-3'><%= l10n("market_kind")%></th>
      <td class='col-sm-2'></td>
    </tr>
  </thead>
  <tbody>
    <% @staff.each do |staff| %>
      <% organization = BenefitSponsors::Organizations::Organization.where(:"profiles._id" => staff.assister_role.benefit_sponsors_assister_agency_profile_id).first %>
      <tr>
        <td class='col-sm-4'><%= staff.first_name + ' ' + staff.last_name %></td>
        <td class='col-sm-3'><%= organization.legal_name %></td>
        <td class='col-sm-3'><% market_kind = organization.assister_agency_profile.market_kind.to_s %>
          <%= (market_kind.eql? "both") ? l10n("shop_and_individual") : market_kind.titleize %><%= l10n("market")%></td>
        <td class='col-sm-2'><a href='#' data-assister='<%=staff.assister_role.id%>' class='assister_select_button'><%= l10n("select")%></a></td>
    </tr>
    <% end %>
  </tbody>
<% else %>
  <thead>
    <tr class='row'>
      <th class='col-sm-4'><%= l10n("assister_name")%></th>
      <th class='col-sm-3'><%= l10n("agency_name")%></th>
      <th class='col-sm-3'><%= l10n("market_kind")%></th>
      <th class='col-sm-2'></th>
    </tr>
  </thead>
  <tbody>
    <% @staff.each do |staff| %>
      <% organization = BenefitSponsors::Organizations::Organization.where(:"profiles._id" => staff.assister_role.benefit_sponsors_assister_agency_profile_id).first %>
      <tr class='row'>
        <td class='col-sm-4'><%= staff.first_name + ' ' + staff.last_name %></td>
        <td class='col-sm-3'><%= organization.legal_name %></td>
        <td class='col-sm-3'><% market_kind = organization.assister_agency_profile.market_kind.to_s %>
          <%= (market_kind.eql? "both") ? l10n("shop_and_individual") : market_kind.titleize %><%= l10n("market")%></td>
        <td class='col-sm-2'><a href='#' data-assister='<%=staff.assister_role.id%>' class='assister_select_button'><%= l10n("select")%></a></td>
    </tr>
    <% end %>
  </tbody>
<% end %>
