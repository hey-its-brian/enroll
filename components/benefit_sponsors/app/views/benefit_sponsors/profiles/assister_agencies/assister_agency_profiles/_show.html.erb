<h1><%= @assister_agency_profile.organization.legal_name %></h1>
<section class="my-4">
  <h2><%= l10n("assister_agencies.agency_details") %></h2>
  <div class="table-responsive">
    <table class="table col-8 border-top-0">
      <thead>
        <th><%= l10n("legal_name")%></th>
        <th><%= l10n("dba").to_s.upcase %></th>
        <th><%= l10n("fein").to_s.upcase%></th>
        <th><%= l10n("market_kind")%></th>
      </thead>
      <tbody>
        <td><%= @assister_agency_profile.organization.legal_name %></td>
        <td><%= @assister_agency_profile.organization.dba %></td>
        <td><%= @assister_agency_profile.organization.fein %></td>
        <td><%= @assister_agency_profile.market_kind.to_s.titleize %></td>
      </tbody>
    </table>
  </div>
  <% if current_user.has_assister_agency_staff_role? || current_user.has_hbx_staff_role? %>
    <%= link_to(edit_profiles_registration_path(@assister_agency_profile.id), class: 'btn btn-secondary mb-4', disabled: disable_edit_assister_agency?(current_user)) do %>
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none" class="mr-2">
        <title><%= l10n("assister_agencies.edit_icon") %></title>
        <path d="M9.677 2.3842L13.613 6.3202L5.57506 14.3588C5.36997 14.5639 5.12323 14.7214 4.85236 14.8212L4.68708 14.8741L0.632111 15.98C0.285522 16.0745 -0.0345414 15.786 0.00300655 15.4454L0.0181704 15.3661L1.12407 11.3111C1.20039 11.0313 1.33646 10.7721 1.52212 10.551L1.63939 10.4231L9.677 2.3842ZM11.2452 0.817303C12.332 -0.269504 14.0941 -0.269504 15.1809 0.817303C16.2224 1.85883 16.2658 3.52051 15.3111 4.61371L15.1809 4.75298L14.32 5.6132L10.384 1.6772L11.2452 0.817303Z" fill="currentColor"/>
      </svg>
      <%= l10n("assister_agencies.edit_profile") %>
    <% end %>
  <% end %>
</section>
<% if @assister_agency_profile.assister_agency_contacts&.any? %>
<section class="my-4">
  <%= render "benefit_sponsors/profiles/assister_agencies/assister_agency_profiles/assister_agency_contacts", assister_agency_contacts: @assister_agency_profile.assister_agency_contacts %>
</section>
<% end %>
<section class="my-4">
  <%= render "benefit_sponsors/profiles/assister_agencies/assister_agency_profiles/office_locations", office_locations: @assister_agency_profile.office_locations %>
</section>
<section class="my-4">
  <%= render "benefit_sponsors/profiles/assister_agencies/assister_agency_profiles/assister_agency_staff_table", assister_staff: Person.staff_for_assister_including_pending(@assister_agency_profile).to_a %>
</section>
<% if @histories && !(current_user.has_assister_agency_staff_role? && disable_edit_assister_agency?(current_user)) %>
<section class="my-4">
  <h2><%= l10n("history") %></h2>
  <% @histories.each do |transition| %>
    <%= transition.to_html %>
  <% end %>
</section>
<% end %>
