<% if @bs4 %>
<div class="mt-4 mb-4">
  <%= v.label :country_of_citizenship, l10n("insured.consumer_roles.docs_shared.country_of_citizenship"), class: "weight-n" %>
  <%= v.select :country_of_citizenship,
               ::VlpDocument::COUNTRIES_LIST,
               { include_blank: l10n("insured.consumer_roles.docs_shared.country_of_citizenship"), allow_blank: true },
               { class: "select_tag", id: "country_of_citizenship" } %>
</div>
<% else %>
<div class="col-md-4 col-sm-4 col-xs-6 form-group form-group-lg no-pd doc_fields select_tag">
  <%= v.select :country_of_citizenship, 
               ::VlpDocument::COUNTRIES_LIST, 
               { include_blank: l10n("insured.consumer_roles.docs_shared.country_of_citizenship"), allow_blank: true }, 
               { class: "select_tag" } %><br>
</div>
<% end %>
