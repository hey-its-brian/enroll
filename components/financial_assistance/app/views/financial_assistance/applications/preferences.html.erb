<% if @bs4 %>
  <% qhp_enabled = qhp_application_feature_enabled? %>
  <% page_title = qhp_enabled ? "preferences_page" : "review_page" %>
  <% step_number = calculate_step_number(@application, page_title) %>
  <%= render partial: '/financial_assistance/shared/faa_progress_options', locals: {step: step_number} %>
  <%= form_for @application, url: {action: "save_preferences"}, method: :put, html:   { data: { controller: "contact-methods",
                                                                                                target: "contact-methods.preferencesForm" } } do |f| %>
    <h1><%= l10n("qhp_application.nav.preferences_label") %></h1>
    <p><%= l10n("insured.preferences.instructions") %> <b><%= l10n("insured.preferences.instructions_continue") %></b>.</p>
    <h2><%= l10n("insured.preferences.agreements") %></h2>
    <fieldset class="mb-4">
      <legend class="weight-n required"><%= l10n("insured.preferences.question1", site_short_name: site_short_name) %></legend>
      <div class="focus d-flex align-items-center mt-2 mb-2">
        <label class="radio-label radio" for="eligibility_easier_yes">
          <%= f.radio_button("is_renewal_authorized", true, class: "radio-yml", id: "eligibility_easier_yes") %>
          <% if qhp_application_feature_enabled? %>
            <%= l10n('qhp_application.preferences.i_agree') %>
          <% else %>
            <%= l10n("insured.preferences.i_agree") %>
          <% end %>
        </label>
        <label class="radio-label radio" for="eligibility_easier_no">
          <%= f.radio_button("is_renewal_authorized", false, class: "radio-yml", id: "eligibility_easier_no") %>
          <% if qhp_application_feature_enabled? %>
            <%= l10n('qhp_application.preferences.i_disagree') %>
          <% else %>
            <%= l10n("insured.preferences.i_disagree") %>
          <% end %>
        </label>
      </div>
    </fieldset>
    <div class="my-4" id="renewal_years">
      <p><%= l10n("insured.preferences.question2_description", site_short_name: site_short_name) %></p>
      <label class="weight-n required" for="application_years_to_renew"><%= l10n("insured.preferences.question2") %></label>
      <%= f.select(:years_to_renew, options_for_select(renewal_year_select_options, selected: f.object.years_to_renew), {include_blank: l10n("insured.preferences.select")}, {prompt: true,  data: qhp_enabled ? {target: "contact-methods.yearsToRenew"} : {}}) %>
    </div>
    <% if qhp_enabled %>
      <% primary_applicant = @application.primary_applicant %>
      <%= f.fields_for :applicants, primary_applicant do |app_f| %>
        <h2><%= l10n("qhp_application.review.contact_preferences") %></h2>
        <p><%= l10n("insured.preferences.contact_update_info") %><span class="primary-text"><%= link_to l10n("insured.preferences.family_info_page"), application_applicants_path(@application) %></span></p>
        <section>
          <div id="phone_info">
            <div class="phone d-flex mb-md-2 row col-sm">
              <% home_phone = primary_applicant.home_phone.present? ? primary_applicant.home_phone : primary_applicant.phones.build(kind: "home") %>
              <% mobile_phone = primary_applicant.mobile_phone.present? ? primary_applicant.mobile_phone : primary_applicant.phones.build(kind: "mobile") %>
              <% [home_phone, mobile_phone].each_with_index do |phone_obj, idx| %>
                <%= app_f.fields_for :phones, phone_obj, child_index: idx, errors: {}, fieldset: true do |phone|  %>
                  <% kind = phone.object.kind.upcase %>
                  <% required = kind == 'HOME' ? "required" : "" %>
                  <%= phone.hidden_field :kind %>
                  <%= phone.hidden_field :_destroy %>
                  <div class="col-sm col-md-6 p-0">
                    <div class="col-md-12 <%= idx.even? ? 'pl-0' : 'pr-0'%>">
                      <% unless kind == 'FAX' && params[:action] == "personal" %>
                        <%= phone.label :full_phone_number, l10n(kind + "Phone") %>
                        <%= phone.text_field :full_phone_number, placeholder: "(000) 000-0000", class: "#{required} full-width phone_number #{kind.downcase}-phone-number", data: {target: "contact-methods.#{kind.downcase}Phone", action: "change->contact-methods#canSubmitCheck"} %>
                      <% end %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
          <div id="email_info">
            <div class="email d-flex mb-md-4 row col-sm">
              <% email = primary_applicant.home_email.present? ? primary_applicant.home_email : primary_applicant.emails.build(kind: "home") %>
              <% work_email = primary_applicant.work_email.present? ? primary_applicant.work_email : primary_applicant.emails.build(kind: "work") %>
              <% [email, work_email].each_with_index do |email_obj, idx| %>
                <%= app_f.fields_for :emails, email_obj, child_index: idx, errors: {}, fieldset: true do |f| %>
                  <% kind = f.object.kind %>
                  <div class="col-sm col-md-6 p-0">
                    <div class="col-md-12 <%= idx.even? ? 'pl-0' : 'pr-0'%>">
                      <%= f.hidden_field :kind %>
                      <%= f.hidden_field :_destroy %>
                      <%= f.label :address, kind.upcase.eql?('HOME') ? l10n("personal_email_address") : l10n(kind + " Email Address").titleize %>
                      <%= f.email_field :address, placeholder: "example@mail.com", class: "full-width", data: {target: "contact-methods.#{kind.downcase}Email", action: "change->contact-methods#canSubmitCheck"} %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </div>
          </div>
        </section>

        <section>
          <h3><%= l10n("notices") %></h3>
          <% if EnrollRegistry.feature_enabled?(:enroll_sms_notifications) %>
            <p>
              <%= l10n(
                  "insured.preferences.notices_disclosure",
                  site_short_name: EnrollRegistry[:enroll_app].setting(:short_name).item,
                  operating_entity: EnrollRegistry[:enroll_app].setting(:operating_entity).item
                ) 
              %>
              <br>
              <%= l10n("insured.preferences.sms_note") %>
            </p>
          <% else %>
            <p><%= l10n("insured.preferences.notices_description", site_short_name: EnrollRegistry[:enroll_app].setting(:short_name).item) %><br><%= l10n("insured.preferences.data_rates_notice") %></p>
          <% end %>

          <div class="<%= 'hidden' if @identifier %>">
            <fieldset class="d-block col-sm-12 p-0">
              <legend><%= l10n("insured.preferences.contact_methods") %></legend>
              <% if EnrollRegistry.feature_enabled?(:contact_method_via_dropdown) %>
                <%= app_f.select :contact_method,
                                 options_for_select([
                                                      [l10n("insured.preferences.paper_only"), "Only Paper communication"],
                                                      [l10n("insured.preferences.electronic_only"), "Only Electronic communications"],
                                                      [l10n("insured.preferences.both_methods"), "Paper and Electronic communications"]
                                                    ], selected: app_f.object.contact_method),
                                 {prompt: l10n("insured.preferences.select_communications")} %>
              <% else %>
                <div class="d-flex mb-md-4 row col-sm">
                  <% {
                       email: l10n("insured.contact_option.email"),
                       mail: l10n("insured.contact_option.mail"),
                       text: l10n("insured.contact_option.text")
                     }.each do |type_key, type_string| %>
                    <div class="col-sm col-md-3 p-0">
                      <% check_box_id = "contact_type_#{type_key}" %>
                      <%= app_f.label(:contact_method, for: check_box_id) do %>
                        <div class="d-flex col-4 p-0 pr-3 align-items-center option weight-n">
                      <span class="mr-2 contact-method">
                        <%= app_f.check_box(:contact_method,
                                            {
                                              checked: (FinancialAssistance::Applicant::CONTACT_METHOD_MAPPING.invert)[app_f.object.contact_method].to_a.include?(type_string),
                                              multiple: true,
                                              id: check_box_id,
                                              data: {target: "contact-methods.#{type_key}Preference", action: "change->contact-methods#canSubmitCheck"}
                                            }, type_string, nil) %>
                      </span>
                          <%= type_string %>
                        </div>
                      <% end %>
                    </div>
                  <% end %>
                </div>
              <% end %>
            </fieldset>

            <div class="col-sm-12 mb-4 p-0">
              <%= app_f.label :language_preference, l10n("insured.preferences.language_preferences"), class: 'personal_landing_page_label required' %>
              <%= app_f.select :language_preference,
                               options_for_select(
                                 EnrollRegistry[:state_based_language_preferences].item || ["English"],
                                 selected: app_f.object.language_preference
                               ),
                               {prompt: l10n("insured.preferences.select_language")} %>
            </div>
          </div>
        </section>
      <% end %>
    <% end %>
    <% primary_applicant = @application.primary_applicant %>
    <% if FinancialAssistanceRegistry.feature_enabled?(:voter_registration_through_ext_url) %>
      <section class="my-4">
        <h2><%= l10n("insured.preferences.voter_registration_header") %></h2>
        <% if qhp_application_feature_enabled? %>
          <p><%= l10n("insured.preferences.voter_registration_description") %> <%= h(link_to(l10n("qhp_application.preferences.voter_registration_link_text"), l10n("insured.preferences.voter_registration_link"), target: "_blank", rel: 'noopener noreferrer')) %>.</p>
        <% else %>
          <p><%= l10n("insured.preferences.voter_registration_description") %> <%= h(link_to(l10n("insured.preferences.voter_registration_link"), l10n("insured.preferences.voter_registration_link"), target: "_blank", rel: 'noopener noreferrer')) %>.</p>
        <% end %>
      </section>
    <% end %>
    <% if FinancialAssistanceRegistry.feature_enabled?(:voter_registration_through_hbx) %>
      <section class="my-4">
        <h2><%= l10n("insured.preferences.voter_registration_header") %></h2>
        <fieldset class="mb-4">
          <legend class="weight-n">
            <label class="weight-n required"><%= l10n("insured.preferences.hbx_registration.question1", state_abbreviation: aca_state_abbreviation) %></label>
            <p><%= l10n("insured.preferences.form_mailed") %></p>
          </legend>
          <div class="focus d-flex align-items-center mt-2 mb-2">
            <label class="radio-label radio" for="mailed_yes">
              <%= f.radio_button("is_requesting_voter_registration_application_in_mail", true, class: "radio-yml", id: "mailed_yes") %>
              <%= l10n("yes") %>
            </label>
            <label class="radio-label radio" for="mailed_no">
              <%= f.radio_button("is_requesting_voter_registration_application_in_mail", false, class: "radio-yml", id: "mailed_no") %>
              <%= l10n("no") %>
            </label>
          </div>
        </fieldset>
        <div class="alert alert-info d-flex" role="alert">
          <div class="pl-2">
            <div class="info-icon icon" alt="info" aria-hidden="true">&nbsp;</div>
          </div>
          <div class="mt-1 pl-0 pr-2 mb-1">
            <p><%= l10n("insured.preferences.hbx_registration.no_warnings1") %></p>
            <p><%= l10n("insured.preferences.hbx_registration.no_warnings2") %></p>
            <ul>
              <li><%= l10n("insured.preferences.hbx_registration.bullet1") %></li>
              <li><%= l10n("insured.preferences.hbx_registration.bullet2") %></li>
              <li><%= l10n("insured.preferences.hbx_registration.bullet3") %></li>
            </ul>
            <p class="bold"><%= l10n("insured.preferences.hbx_registration.file_a_complaint") %></p>
            <%= Settings.contact_center.board_of_elections_entity %> <br>
            <%= h(raw(Settings.contact_center.board_of_elections_address)) %> <br>
            <%= Settings.contact_center.board_of_elections_email %> <br>
            <%= l10n("phone") %>: <%= Settings.contact_center.board_of_elections_phone_number %>
          </div>
        </div>
      </section>
    <% end %>
    <% content_for :submit_button do %>
      <%= f.submit(
            l10n("continue_next"),
            class:   "btn btn-continue",
            id:      "btn-continue",
            data:    (qhp_enabled ?
                        { target: "contact-methods.submitButton",
                          action: "click->contact-methods#validateSubmission" }
                        : {})
          ) %>
    <% end %>
    <% previous_link = qhp_enabled ? edit_application_path(@application) : review_and_submit_application_path(@application)  %>
    <% show_back_to_household_button = qhp_enabled ? false : true %>
    <%= render partial: 'financial_assistance/shared/progress_navigation_buttons', locals: {
      previous_link: previous_link, show_back_to_household_button: show_back_to_household_button
    } %>
  <% end %>
    <% if qhp_application_feature_enabled? %>
    <%= render partial: 'shared/leaving_modal' %>
  <% end %>
<% else %>
  <%= form_for @application, url: {action: "save_preferences"}, method: :put do |f| %>
    <div class="col-lg-10 col-md-10 col-sm-10 col-xs-12 row">
      <div class="col-md-9">
        <div class="">
          <p class="alert alert-error hide"></p>
          <div class="row">
            <div class="col-md-10">
              <h2 class="fa-darkblue">Your Preferences</h2>
            </div>
          </div>
          <p>Tell us your preferences. When you're finished, select CONTINUE.</p>
          <p class="memo">* = required field</p>
          <div class="focus_effect module">
            <div class="margin-bottom-30">
              <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                <div class="col-md-6">
                  To make it easier to determine my eligibility for premium reductions in future years, I agree to allow <short-name-placeholder> to use my income data, including information from tax returns, for the next five years. <short-name-placeholder> will send me a notice, let me make any changes, and I can opt out at any time. *<br>
                </div>
                <div class="col-md-3">
                  <%= f.radio_button("is_renewal_authorized", true, class: "radio-yml", id: "eligibility_easier_yes") %>
                  <label class="radio-yml" for="eligibility_easier_yes">I agree</label>
                </div>
                <div class='col-md-3'>
                  <%= f.radio_button("is_renewal_authorized", false, class: "radio-yml", id: "eligibility_easier_no") %>
                  <label class="radio-yml" for="eligibility_easier_no">I disagree</label>
                </div>
              </div>
              <div id="renewal_years">
                <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                  <div class="col-md-12">
                    When it’s time to renew or change coverage, I authorize <%= ::EnrollRegistry[:enroll_app].setting(:short_name).item %> to automatically check my federal income tax returns for the sole purpose of redetermining my eligibility.
                  </div>
                </div>
                <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                  <div class="col-md-12">
                    How long would you like your eligibility for premium reductions to be renewed? *
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 5, class: "radio-yml") %>
                    <label class="radio-yml span-text">5 years</label>
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 4, class: "radio-yml") %>
                    <label class="radio-yml span-text">4 years</label>
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 3, class: "radio-yml") %>
                    <label class="radio-yml span-text">3 years</label>
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 2, class: "radio-yml") %>
                    <label class="radio-yml span-text">2 years</label>
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 1, class: "radio-yml") %>
                    <label class="radio-yml span-text">1 years</label>
                  </div>
                  <div class="col-md-12">
                    <%= f.radio_button("years_to_renew", 0, class: "radio-yml") %>
                    <label class="radio-yml span-text radio-inline-override label-max-width-renew">None. I understand that this means I won't get cost savings in future years unless I change my mind and tell <%= ::EnrollRegistry[:enroll_app].setting(:short_name).item %>.</label>
                  </div>
                </div>
              </div>
            </div>
            <% if FinancialAssistanceRegistry.feature_enabled?(:voter_registration_through_hbx) %>
              <div class="margin-bottom-30 clear mt-4">
                <h2 class="darkblue">Voter Registration</h2>
                <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                  <div class="col-md-8">
                    Would you like to register to vote in <%= aca_state_abbreviation %> or update your current registration? * (A form will be mailed to you)
                  </div>
                  <div class="col-md-2">
                    <%= f.radio_button("is_requesting_voter_registration_application_in_mail", true, class: "radio-yml", id: "mailed_yes") %>
                    <label class="radio-yml" for="mailed_yes">Yes</label>
                  </div>
                  <div class="col-md-2">
                    <%= f.radio_button("is_requesting_voter_registration_application_in_mail", false, class: "radio-yml", id: "mailed_no") %>
                    <label class="radio-yml" for="mailed_no">No</label>
                  </div>
                </div>
                <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                  <div class="col-md-12">
                    <b>PLEASE NOTE:</b> If you select 'No' you will be considered to have decided not to have requested a voter registration form at this time.<br><br>
                      You may file a complaint if you believe that someone has interfered with: <br><br>
                      * Your right to register or not register to vote <br>
                      * Your right to privacy in deciding whether or not to register to vote <br>
                      * Your right to choose your own political party or other political choice <br><br>

                      <b>To file a complaint, contact:</b><br>
                    <%= Settings.contact_center.board_of_elections_entity %> <br>
                    <%= h(raw(Settings.contact_center.board_of_elections_address)) %> <br>
                    <%= Settings.contact_center.board_of_elections_email %> <br>
                    Phone: <%= Settings.contact_center.board_of_elections_phone_number %>
                  </div>
                </div>
              </div>
            <% end %>
            <% if FinancialAssistanceRegistry.feature_enabled?(:voter_registration_through_ext_url) %>
              <div class="margin-bottom-30 clear mt-4">
                <h2 class="darkblue">Voter Registration</h2>
                <div class="row row-form-wrapper radio-align no-buffer row-height yml-row small-padding-top-bottom">
                  <div class="col-md-12">
                    If you are not registered to vote where you live now and would like to apply to register to vote, visit: <a href='https://www.maine.gov/sos/cec/elec/voter-info/voterguide.html?ref=voteusa' target='_blank' rel='noopener noreferrer'>https://www.maine.gov/sos/cec/elec/voter-info/voterguide.html?ref=voteusa</a>.
                  </div>
                </div>
              </div>
            <% end %>
          </div>
          <div class="row">
            <div class="col-xs-12">
              <div class="back-link">
                <i class="fa fa-caret-left fa-2x" aria-hidden="true"></i>
                <a href="#" class="back-to-household-link" data-path="<%= financial_assistance.edit_application_path(@application) %>"> <b>BACK TO ALL HOUSEHOLD MEMBERS</b> </a> <span>(Go back and work on another person)</span>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-3">
        <%= submit_tag 'CONTINUE', :class => "btn btn-lg btn-primary btn-block" %>
        <p class="small-left-margin very-small-margin-top faded">
          <ul class='list-unstyled list-right-section'>
            <li>
              <%= h(link_to(financial_assistance.review_and_submit_application_path(@application)) do %>
                PREVIOUS
              <% end) %>
            </li>
            <li>
              <a href="#">
                SAVE &amp; EXIT
              </a>
              <br>
              <br>
            </li>
            <li>
              <p>
                If you select Save &amp; Exit, you can save your work and continue where you left off the next time you login.
              </p>
            </li>
            <br class="clear">
          </ul>
        </p>
        <div id="help_me_sign_up" tabindex="0" onkeydown="handleButtonKeyDown(event, 'help_me_sign_up')" class="btn btn-default btn-block help-me-sign-up" data-target="#help_with_plan_shopping" data-toggle="modal">
          Help me sign up
        </div>
        <%= render partial: './ui-components/v1/modals/help_with_plan'  %>
      </div>
    </div>
  <% end %>
<% end %>
<%= render partial: '/financial_assistance/shared/to_previous_modal' %>
