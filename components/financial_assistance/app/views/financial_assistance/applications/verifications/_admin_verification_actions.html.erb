<% if @bs4 %> 
  <div class="verification-update-reason" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}"%>>
    <%= form_tag financial_assistance.application_applicant_evidences_update_evidence_path(application, applicant), method: :put do %>
      <%= hidden_field_tag 'applicant_id', applicant.id  %>
      <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
      <%= hidden_field_tag 'admin_action', 'verify' %>  
      <div class='mb-2'>
        <label>
          <%= l10n('admin.verifications.verify_reason') %>
          <div class="col-md-4 px-0"><%= select_tag :verification_reason, options_for_select(::Eligibilities::Evidence::VERIFY_REASONS), {prompt: 'Select Reason', required: true, class: 'col'} %></div>
        </label>
      </div>
      <div>
        <%= submit_tag "Confirm", class: "button v-type-confirm-button" %>
      </div>
    <% end %>
  </div>

  <div class="verification-update-reason" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-return"%>>
    <%= form_tag financial_assistance.application_applicant_evidences_update_evidence_path(application, applicant), method: :put do %>
      <%= hidden_field_tag 'applicant_id', applicant.id  %>
      <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
      <%= hidden_field_tag 'admin_action', 'return_for_deficiency' %>
      <div class='mb-2'>
        <label>
          <%= l10n('admin.verifications.reject_reason') %>
          <div class="col-md-4 px-0"><%= select_tag :verification_reason, options_for_select(::Eligibilities::Evidence::REJECT_REASONS), {prompt: 'Select Reason', required: true, class: 'col'} %></div>
        </label>
      </div>
      <div>
        <%= submit_tag "Confirm", class: "button v-type-confirm-button" %>
      </div>
    <% end %>
  </div>

  <div class="fedhub-request" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-hub"%>>
    <p>New request to the FDSH will be sent.</p>
    <%= form_tag financial_assistance.application_applicant_evidences_fdsh_hub_request_path(application, applicant), method: :post do %>
      <%= hidden_field_tag 'applicant_id', applicant.id  %>
      <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
      <%= hidden_field_tag 'admin_action', 'hub_request' %>   
      <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
    <% end %>
  </div>


  <div class="extend-request" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-extend"%>>
    <% unless EnrollRegistry.feature_enabled?(:verification_due_on_options) %>
      <p><%= l10n('admin.verifications.extend.do_you_want_to_extend') %></p>
    <% end %>
    <%= form_tag financial_assistance.application_applicant_evidences_extend_due_date_path(application, applicant), method: :put do %>
      <%= hidden_field_tag 'applicant_id', applicant.id  %>
      <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
      <%= hidden_field_tag 'admin_action', 'extend' %> 
      <% if EnrollRegistry.feature_enabled?(:verification_due_on_options) %>
        <label class="my-3" id="due-on-options">
          <%= l10n('admin.verifications.extend.due_date_options') %>
          <%= select_tag :extension_period, options_for_select(admin_evidence_due_on_options(due_on)), prompt: l10n('admin.verifications.extend.due_date_options.select'), class: 'd-block col-5', required: true, allow_blank: false %>
        </label>
        <label id="manual-due-on" class="my-3 hidden">
          <%= l10n('admin.verifications.extend.due_date_options.enter_manual_date') %>
          <%= date_field_tag :due_on, date_field_value(due_on), min: date_field_value, required: true, disabled: true, class: 'd-block' %>
        </label>
      <% end %>
      <div class='d-flex'>
        <%= link_to l10n('cancel'), '#', class: "btn outline mr-2 v-type-confirm-button" %>
        <%= submit_tag l10n('confirm_selection'), class: "btn btn-default v-type-confirm-button" %>
      </div>
    <% end %>
  </div>

   <% unless EnrollRegistry.feature_enabled?(:show_new_verifications_household_summary) %>
    <!-- ***** View History ***** -->
    <div class="row">
      <div class="view-history col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-history"%>>
        <div>
          <h5>Verification History</h5>
          <table class="table table-bordered table-hover table-responsive">
            <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Date</th>
              <th scope="col">Action</th>
              <th scope="col">Modifier/Transaction Id</th>
              <th scope="col">Update Reason</th>
              <th scope="col">Details</th>
            </tr>
            </thead>
            <tbody>
              <% records = (evidence.verification_histories + evidence.request_results).flatten.sort_by(&:created_at).reverse! %>
              <% records.each_with_index do |record, index| %>
                <tr>
                  <th scope="row"><%= index + 1 %></th>
                  <td><%= record&.date_of_action&.in_time_zone('Eastern Time (US & Canada)') %></td>
                  <td><%= (record.is_a?(Eligibilities::RequestResult) && record.action.nil?) ? 'Hub Call' : record.action.capitalize %></td>
                  <td><%= record.is_a?(Eligibilities::RequestResult) ? record.source_transaction_id : record.updated_by %></td>
                  <td><%= record.is_a?(Eligibilities::RequestResult) ? 'Fdsh Hub Call' : record.update_reason %></td>
                  <% if record.is_a?(Eligibilities::RequestResult) %>
                    <td>
                      <% if record.raw_payload.present? %>
                        <button type="button" data-toggle="modal" data-target=<%="#record_details_#{record.id}" %>>Payload</button>
                      <% end %>
                    </td>

                    <div class="modal fade" id=<%="record_details_#{record.id}" %>  tabindex="-1" role="dialog" aria-hidden="true">
                      <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h4 class="modal-title"><%= "#{evidence.title.capitalize} payload" %></h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                          </div>
                          <div class="modal-body">
                            <%= JSON.parse(record.raw_payload) if record.raw_payload.present? %>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="col-md-3 pull-right">
            <%= link_to "Cancel", main_app.verification_insured_families_path, class: "btn btn-default" %>
          </div>
        </div>
      </div>
    </div>
  <% end %>

<% else %>
  <!-- ***** Verification reason ***** -->
  <div class="row">
    <div class="verification-update-reason col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}"%>>
      <div class="col-md-6">
        Provide verification reason:
      </div>
      <%= form_tag financial_assistance.application_applicant_evidences_update_evidence_path(application, applicant), method: :put do %>
          <%= hidden_field_tag 'applicant_id', applicant.id  %>
          <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
          <%= hidden_field_tag 'admin_action', 'verify' %>
          <div class="form-group col-md-3">
            <%= select_tag :verification_reason, options_for_select(::Eligibilities::Evidence::VERIFY_REASONS), {prompt: ' Select Reason', required: true}%>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== verification reason ==== -->

  <!-- ***** Reject reason ***** -->
  <div class="row">
    <div class="return-for-def-reason col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-return"%>>
      <div class="col-md-6">
        Reject reason:
      </div>
      <%= form_tag financial_assistance.application_applicant_evidences_update_evidence_path(application, applicant), method: :put do %>
          <%= hidden_field_tag 'applicant_id', applicant.id  %>
          <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
          <%= hidden_field_tag 'admin_action', 'return_for_deficiency' %>
          <div class="form-group col-md-3">
            <%= select_tag :verification_reason, options_for_select(::Eligibilities::Evidence::REJECT_REASONS), {prompt: ' Select Reason', required: true}%>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== reject reason ==== -->

  <!-- ***** FDSH hub request ***** -->
  <div class="row">
    <div class="fedhub-request col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-hub"%>>
      <div class="col-md-9">
        <p>New request to the FDSH will be sent.</p>
      </div>
      <%= form_tag financial_assistance.application_applicant_evidences_fdsh_hub_request_path(application, applicant), method: :post do %>
          <%= hidden_field_tag 'applicant_id', applicant.id  %>
          <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
          <%= hidden_field_tag 'admin_action', 'hub_request' %>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ====  FDSH hub request ==== -->

  <!-- ***** Extend ***** -->
  <div class="row">
    <div class="extend-request col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-extend"%>>
      <div class="col-md-6">
        <p>Do you want to Extend Due Date for verification type</p>
      </div>
      <%= form_tag financial_assistance.application_applicant_evidences_extend_due_date_path(application, applicant), method: :put do %>
          <%= hidden_field_tag 'applicant_id', applicant.id  %>
          <%= hidden_field_tag 'evidence_kind', evidence_kind  %>
          <%= hidden_field_tag 'admin_action', 'extend' %>

          <div class="col-md-3">
            <%= link_to "Cancel", main_app.verification_insured_families_path, class: "btn btn-default v-type-confirm-button" %>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== Extend request ==== -->

  <% unless EnrollRegistry.feature_enabled?(:show_new_verifications_household_summary) %>
    <!-- ***** View History ***** -->
    <div class="row">
      <div class="view-history col-md-12" id=<%="#{applicant.id}-#{evidence_kind.to_s.downcase.split.join('-')}-history"%>>
        <div>
          <h5>Verification History</h5>
          <table class="table table-bordered table-hover table-responsive">
            <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Date</th>
              <th scope="col">Action</th>
              <th scope="col">Modifier/Transaction Id</th>
              <th scope="col">Update Reason</th>
              <th scope="col">Details</th>
            </tr>
            </thead>
            <tbody>
              <% records = (evidence.verification_histories + evidence.request_results).flatten.sort_by(&:created_at).reverse! %>
              <% records.each_with_index do |record, index| %>
                <tr>
                  <th scope="row"><%= index + 1 %></th>
                  <td><%= record&.date_of_action&.in_time_zone('Eastern Time (US & Canada)') %></td>
                  <td><%= (record.is_a?(Eligibilities::RequestResult) && record.action.nil?) ? 'Hub Call' : record.action.capitalize %></td>
                  <td><%= record.is_a?(Eligibilities::RequestResult) ? record.source_transaction_id : record.updated_by %></td>
                  <td><%= record.is_a?(Eligibilities::RequestResult) ? 'Fdsh Hub Call' : record.update_reason %></td>
                  <% if record.is_a?(Eligibilities::RequestResult) %>
                    <td>
                      <% if record.raw_payload.present? %>
                        <button type="button" data-toggle="modal" data-target=<%="#record_details_#{record.id}" %>>Payload</button>
                      <% end %>
                    </td>

                    <div class="modal fade" id=<%="record_details_#{record.id}" %>  tabindex="-1" role="dialog" aria-hidden="true">
                      <div class="modal-dialog modal-lg" role="document">
                        <div class="modal-content">
                          <div class="modal-header">
                            <h4 class="modal-title"><%= "#{evidence.title.capitalize} payload" %></h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                              <span aria-hidden="true">&times;</span>
                            </button>
                          </div>
                          <div class="modal-body">
                            <%= JSON.parse(record.raw_payload) if record.raw_payload.present? %>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                          </div>
                        </div>
                      </div>
                    </div>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>

          <div class="col-md-3 pull-right">
            <%= link_to "Cancel", main_app.verification_insured_families_path, class: "btn btn-default" %>
          </div>
        </div>
      </div>
    </div>
    <!-- ==== view history ==== -->
  <% end %>
<% end %>
