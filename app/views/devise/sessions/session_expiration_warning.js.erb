<% if @time_left <= 30 %>
if (window.countdownTimer) {
  clearInterval(window.countdownTimer);
}

if (!$('#sessionExpirationWarningModal').length) {
  $('nav.top-nav').before("<%= escape_javascript(render partial: "devise/sessions/session_expiration_warning") %>");
  $('#sessionExpirationWarningModal').show();
}

var remainingSeconds = <%= @time_left %>;
var countdownStartTime = Date.now();

function updateCountdown() {
  var elapsedSeconds = Math.floor((Date.now() - countdownStartTime) / 1000);
  remainingSeconds = Math.max(0, <%= @time_left %> - elapsedSeconds);
  
  $('#sessionExpirationWarningModal p strong').text(remainingSeconds);

  if (remainingSeconds <= 0) {
    clearInterval(window.countdownTimer);
    
    $('#sessionExpirationWarningModal p').text("Your session has timed out due to inactivity. Please log back in.");
    $('h4.modal-title').text("Session Ended");
    $('.modal-footer .btn-default').hide();
    $("#stay-logged-in").remove();
    
    $('.modal-footer .btn-primary')
      .attr('tabindex', '0')
      .text('<%= l10n("faa.login") %>')
      .off('keydown')
      .on('keydown', function(event) { 
        handleButtonKeyDown(event, 'stay-logged-in'); 
      });
      
    $('.modal-footer .outline')
      .attr('tabindex', '0')
      .text("<%= l10n("go_to_login") %>")
      .off('keydown')
      .on('keydown', function(event) {
        handleButtonKeyDown(event, 'stay-logged-in');
      });
      
    $('.modal-footer .outline').removeClass('outline').addClass('primary');
  }
}

window.countdownTimer = setInterval(updateCountdown, 1000);

$(document).off('click', '#stay-logged-in').on('click', '#stay-logged-in', function(e) {
  e.preventDefault();
  
  $.ajax({
    url: "<%= reset_user_clock_path(format: :js) %>",
    method: 'GET',
    dataType: 'script',
    cache: false,
    success: function(response) {
      
      $('#sessionExpirationWarningModal').remove();
      
      if (window.countdownTimer) {
        clearInterval(window.countdownTimer);
      }
      
      if (window.logout_check_timer) {
        clearTimeout(window.logout_check_timer);
      }
      window.logout_check_timer = setTimeout(window.check_time_until_logout, <%= (Devise.timeout_in - 30) * 1000 %>);
    },
    error: function(response) {
      window.location.replace('<%= site_redirect_on_timeout_route %>');
    }
  });
});
<% else %>
if (window.logout_check_timer) {
  clearTimeout(window.logout_check_timer);
}

var timeUntilWarning = <%= (@time_left - 30) * 1000 %>;
window.logout_check_timer = setTimeout(window.check_time_until_logout, timeUntilWarning);
<% end %>