<% if flash[:alert].present? %>
window.location.replace('<%= family_index_dt_exchanges_hbx_profiles_path %>');
<% else %>
var containing_row = $("#<%= @element_to_replace_id %>").closest('TR');
var $parent_row = containing_row;

if ( $('tr.child-row:visible').length > 0 ) {
  $('tr.child-row:visible').remove();
  $("li>a:contains('Collapse Form')").addClass('disabled');
}
if ( $parent_row.next().hasClass('child-row') ) {
} else {
  $parent_row.after('<tr class="child-row"><td colspan="100"><%= j render partial: "exchanges/hbx_profiles/tax_forms_list", locals: { messages: @result[:messages], family_id: @result[:family].id, person_id: @result[:family].primary_applicant.person.id, family_actions_id: @element_to_replace_id } %></td></tr>');
  $("li>a:contains('Collapse Form')").eq(containing_row.index()).removeClass('disabled');
  $('.dropdown.pull-right').removeClass('open');
}
<% end %>

