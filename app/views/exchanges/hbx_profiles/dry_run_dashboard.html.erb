<div class="<%= 'container px-0' unless @bs4 %>">
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= l10n("admin_actions.dry_run.applications.title") %></h1>
  
  <!-- Auto-refresh controls -->
  <div class="btn-group" role="group">
    <button type="button" id="manual-refresh" class="btn btn-primary btn-sm" title="Refresh all data now">
      <i class="fas fa-sync-alt"></i> Refresh Now
    </button>
    <button type="button" id="auto-refresh-toggle" class="btn btn-success btn-sm">
      Disable Auto-Refresh
    </button>
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        <span id="current-interval">5 minutes</span>
      </button>
      <div class="dropdown-menu">
        <a class="dropdown-item interval-option active" href="#" data-value="1">1 minute</a>
        <a class="dropdown-item interval-option" href="#" data-value="2">2 minutes</a>
        <a class="dropdown-item interval-option" href="#" data-value="5">5 minutes</a>
      </div>
    </div>
  </div>
</div>

<section class="my-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2><%= l10n("admin_actions.dry_run.renewal_benefit_coverage_values") %></h2>
    <button type="button" class="btn btn-outline-primary btn-sm section-refresh" data-section="benefit-coverage" title="Refresh benefit coverage data">
      <i class="fas fa-sync-alt"></i>
    </button>
  </div>
  <div id="benefit-coverage-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading benefit coverage values...</p>
  </div>
  <div id="benefit-coverage-content" class="d-none"></div>
</section>

<section class="my-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2><%= l10n("admin_actions.dry_run.application_renewal_status") %></h2>
    <button type="button" class="btn btn-outline-primary btn-sm section-refresh" data-section="application-states" title="Refresh application states data">
      <i class="fas fa-sync-alt"></i>
    </button>
  </div>
  <div id="application-states-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading application renewal status...</p>
  </div>
  <div id="application-states-content" class="d-none"></div>
</section>

<section class="my-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2><%= l10n("admin_actions.dry_run.qhp_application_renewal_status") %></h2>
    <button type="button" class="btn btn-outline-primary btn-sm section-refresh" data-section="qhp-application-states" title="Refresh QHP application states data">
      <i class="fas fa-sync-alt"></i>
    </button>
  </div>
  <div id="qhp-application-states-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading QHP application renewal status...</p>
  </div>
  <div id="qhp-application-states-content" class="d-none"></div>
</section>

<section class="my-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2><%= l10n("admin_actions.dry_run.oe_determined_notices") %></h2>
    <button type="button" class="btn btn-outline-primary btn-sm section-refresh" data-section="notices" title="Refresh notices data">
      <i class="fas fa-sync-alt"></i>
    </button>
  </div>
  <div id="notices-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading notice information...</p>
  </div>
  <div id="notices-content" class="d-none"></div>
</section>

<section class="my-3">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h2><%= l10n('admin_actions.dry_run.enrollments.enrollment_states') %> - <%= Family.application_applicable_year %></h2>
    <button type="button" class="btn btn-outline-primary btn-sm section-refresh" data-section="enrollment-states" title="Refresh enrollment states data">
      <i class="fas fa-sync-alt"></i>
    </button>
  </div>
  <div id="enrollment-states-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading enrollment states...</p>
  </div>
  <div id="enrollment-states-content" class="d-none"></div>
</section>

</div>

<%= javascript_include_tag 'dry_run_dashboard' %>

<script>
window.dryRunEndpoints = {
  benefitCoverage: '<%= dry_run_benefit_coverage_exchanges_hbx_profiles_path %>',
  applicationStates: '<%= dry_run_application_states_exchanges_hbx_profiles_path %>',
  qhpApplicationStates: '<%= dry_run_qhp_application_states_exchanges_hbx_profiles_path %>',
  notices: '<%= dry_run_notices_exchanges_hbx_profiles_path %>',
  enrollmentStates: '<%= dry_run_enrollment_states_exchanges_hbx_profiles_path %>'
};
</script>
