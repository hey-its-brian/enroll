<div class="<%= 'container px-0' unless @bs4 %>">
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1><%= l10n("admin_actions.dry_run.applications.title") %></h1>
  
  <!-- Auto-refresh controls -->
  <div class="btn-group" role="group">
    <button type="button" id="manual-refresh" class="btn btn-primary btn-sm" title="Refresh all data now">
      <i class="fas fa-sync-alt"></i> Refresh Now
    </button>
    <button type="button" id="auto-refresh-toggle" class="btn btn-success btn-sm">
      Disable Auto-Refresh
    </button>
    <div class="btn-group" role="group">
      <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
        Interval
      </button>
      <div class="dropdown-menu">
        <select id="refresh-interval" class="form-control form-control-sm border-0 bg-transparent">
          <option value="1">1 minute</option>
          <option value="2">2 minutes</option>
          <option value="5" selected>5 minutes</option>
          <option value="10">10 minutes</option>
          <option value="15">15 minutes</option>
          <option value="30">30 minutes</option>
        </select>
      </div>
    </div>
  </div>
</div>

<section class="my-3">
  <h2><%= l10n("admin_actions.dry_run.renewal_benefit_coverage_values") %></h2>
  <div id="benefit-coverage-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading benefit coverage values...</p>
  </div>
  <div id="benefit-coverage-content" class="d-none"></div>
</section>

<section class="my-3">
  <h2><%= l10n("admin_actions.dry_run.application_renewal_status") %></h2>
  <div id="application-states-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading application renewal status...</p>
  </div>
  <div id="application-states-content" class="d-none"></div>
</section>

<section class="my-3">
  <h2><%= l10n("admin_actions.dry_run.oe_determined_notices") %></h2>
  <div id="notices-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading notice information...</p>
  </div>
  <div id="notices-content" class="d-none"></div>
</section>

<section class="my-3">
  <h2><%= l10n('admin_actions.dry_run.enrollments.enrollment_states') %></h2>
  <div id="enrollment-states-loading" class="text-center p-3">
    <div class="spinner-border text-primary" role="status">
      <span class="sr-only">Loading...</span>
    </div>
    <p class="mt-2 text-muted">Loading enrollment states...</p>
  </div>
  <div id="enrollment-states-content" class="d-none"></div>
</section>

</div>

<%= javascript_include_tag 'dry_run_dashboard' %>

<script>
window.dryRunEndpoints = {
  benefitCoverage: '<%= dry_run_benefit_coverage_exchanges_hbx_profiles_path %>',
  applicationStates: '<%= dry_run_application_states_exchanges_hbx_profiles_path %>',
  notices: '<%= dry_run_notices_exchanges_hbx_profiles_path %>',
  enrollmentStates: '<%= dry_run_enrollment_states_exchanges_hbx_profiles_path %>'
};
</script>
