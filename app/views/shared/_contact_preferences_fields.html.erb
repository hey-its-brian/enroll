<input type='hidden' data-target="contact-methods.enrollSmsNotificationsInput" value="<%= EnrollRegistry.feature_enabled?(:enroll_sms_notifications) %>">
<input type='hidden' data-target="contact-methods.disableSubmissionInput" value="<%= local_assigns[:disable_submission].nil? ? true : local_assigns[:disable_submission] %>">

<section>
  <div id="phone_info">
    <div class="phone d-flex mb-md-2 row col-sm">
      <% home_phone = config[:contact_object].home_phone.present? ? config[:contact_object].home_phone : config[:contact_object].phones.build(kind: "home") %>
      <% mobile_phone = config[:contact_object].mobile_phone.present? ? config[:contact_object].mobile_phone : config[:contact_object].phones.build(kind: "mobile") %>
      <%= config[:form_builder].fields_for :phones, [home_phone, mobile_phone], errors: {}, fieldset: true do |phone|  %>
        <% kind = phone.object.kind.upcase %>
        <% required = kind == 'HOME' ? "required" : "" %>
        <%= phone.hidden_field :kind %>
        <div class="col-sm col-md-6 p-0" data-target="contact-methods.methodContainer">
          <%= phone.hidden_field :_destroy, class: "destroy" %>
          <div class="col-md-12 <%= phone.index.even? ? 'pl-0' : 'pr-0'%>">
            <% unless kind == 'FAX' && params[:action] == "personal" %>
              <%= phone.label :full_phone_number, l10n(kind + "Phone") %>
              <%= phone.text_field :full_phone_number, placeholder: "(000) 000-0000", class: "#{required} full-width phone_number #{kind.downcase}-phone-number", data: {target: "contact-methods.#{kind.downcase}Phone", action: "change->contact-methods#updateFormState"} %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <div id="email_info">
    <div class="email d-flex mb-md-4 row col-sm">
      <% email = config[:contact_object].home_email.present? ? config[:contact_object].home_email : config[:contact_object].emails.build(kind: "home") %>
      <% work_email = config[:contact_object].work_email.present? ? config[:contact_object].work_email : config[:contact_object].emails.build(kind: "work") %>
      <%= config[:form_builder].fields_for :emails, [email, work_email], errors: {}, fieldset: true do |f| %>
        <% kind = f.object.kind %>
        <div class="col-sm col-md-6 p-0">
          <div class="col-md-12 <%= f.index.even? ? 'pl-0' : 'pr-0'%>" data-target="contact-methods.methodContainer">
            <%= f.hidden_field :kind %>
            <%= f.hidden_field :_destroy, class: "destroy" %>
            <%= f.label :address, kind.upcase.eql?('HOME') ? l10n("personal_email_address") : l10n(kind + " Email Address").titleize %>
            <%= f.email_field :address, placeholder: "example@mail.com", class: "full-width", data: {target: "contact-methods.#{kind.downcase}Email", action: "change->contact-methods#updateFormState"} %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%= with_preferences_form(config) do |prefs_form| %>
  <section>
    <h2 class='gamma'><%= l10n("notices") %></h2>
    <% if EnrollRegistry.feature_enabled?(:enroll_sms_notifications) %>
      <p>
        <%= l10n(
            "insured.preferences.notices_disclosure",
            site_short_name: EnrollRegistry[:enroll_app].setting(:short_name).item,
            operating_entity: EnrollRegistry[:enroll_app].setting(:operating_entity).item
          )
        %>
      </p>
      <p><%= l10n("insured.preferences.sms_note") %></p>
    <% else %>
      <p><%= l10n("insured.preferences.notices_description", site_short_name: EnrollRegistry[:enroll_app].setting(:short_name).item) %><br><%= l10n("insured.preferences.data_rates_notice") %></p>
    <% end %>

    <div class="<%= 'hidden' if @identifier %>">
      <fieldset class="d-block col-sm-12 p-0">
        <legend><%= l10n("insured.preferences.contact_methods") %></legend>
        <% if EnrollRegistry.feature_enabled?(:contact_method_via_dropdown) %>
          <%= prefs_form.select :contact_method,
              options_for_select([
                [l10n("insured.preferences.paper_only"), "Only Paper communication"],
                [l10n("insured.preferences.electronic_only"), "Only Electronic communications"],
                [l10n("insured.preferences.both_methods"), "Paper and Electronic communications"]
              ], selected: prefs_form.object.contact_method),
              {prompt: l10n("insured.preferences.select_communications")} %>
        <% else %>
          <div class="d-flex mb-md-4 row col-sm">
            <% {
              email: l10n("insured.contact_option.email"),
              mail: l10n("insured.contact_option.mail"),
              text: l10n("insured.contact_option.text")
            }.each do |type_key, type_string| %>
              <div class="col-sm col-md-3 p-0">
                <% check_box_id = "contact_type_#{type_key}" %>
                <%= prefs_form.label(:contact_method, for: check_box_id) do %>
                  <div class="d-flex col-4 p-0 pr-3 align-items-center option weight-n">
                    <span class="mr-2 contact-method">
                      <%= prefs_form.check_box(:contact_method,
                          {
                            checked: (config[:contact_method_mapping].invert)[prefs_form.object.contact_method].to_a.include?(type_string),
                            multiple: true,
                            id: check_box_id,
                            data: {target: "contact-methods.#{type_key}Preference", action: "change->contact-methods#updateFormState"}
                          }, type_string, nil) %>
                    </span>
                    <%= type_string %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        <% end %>
      </fieldset>

      <div class="col-sm-12 mb-4 p-0">
        <%= prefs_form.label :language_preference, l10n("insured.preferences.language_preferences"), class: 'personal_landing_page_label required' %>
        <%= prefs_form.select :language_preference,
            options_for_select(
              EnrollRegistry[:state_based_language_preferences].item || ["English"],
              selected: prefs_form.object.language_preference
            ),
            {prompt: l10n("insured.preferences.select_language")} %>
      </div>
    </div>
  </section>
<% end %>
