<% if qhp_application_feature_enabled?%>
<div class="modal" id="addressChangeConfirmation" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="container py-3 px-3 modal-content px-0">
        <div class="modal-header d-flex align-items-center border-0 p-0">
          <div class="col-auto p-0">
            <div class="warning-icon icon icon-sm" alt="warning" aria-hidden="true">&nbsp;</div>
          </div>
          <div class="col p-0 bold">
            <%= l10n('faa.address_change_confirmation_header') %>
          </div>
          <div class="col-auto p-0">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <div class="close-icon icon-min align-self-start m-0" aria-hidden="true">&nbsp;</div>
            </button>
          </div>
        </div>
        <div class="modal-body border-0 px-0">
          <strong><%= l10n('faa.address_change_confirmation_description1') %></strong>
          <%= l10n('faa.address_change_confirmation_description2') %>
        </div>
        <div class="d-flex align-items-center mt-4 justify-content-end">
          <button type="button" class="btn btn-primary btn-confirmation address-change-confirmation"><%= l10n('faa.address_change_confirmation_ok_button') %></button>
        </div>
      </div>
    </div>
  </div>
<% else %>
<div class="modal" id="addressChangeConfirmation" role="dialog">
  <div class="modal-dialog" style="width: 500px;">
    <div class="modal-content">
      <div class="modal-header" style="text-align: center;">
        <h4 class="modal-title">
          <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
          Important
        </h4>
      </div>
      <div class="modal-body" style="text-align: center;">
        <i class="fa fa-info-circle"></i> <strong>The changes you're making here only apply to this person.</strong>
        <br><br>
        <p>for example, if you made an address change and want to make the same change on any other household members. You must go to manage family and select the family tab to make the change.</p>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary btn-confirmation address-change-confirmation">OK, I GOT IT</button>
      </div>
    </div>
  </div>
</div>
<% end%>
