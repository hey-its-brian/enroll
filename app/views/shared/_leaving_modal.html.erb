<a class="hidden" id="leavingWarningModalTrigger" href="#leavingWarningModal" data-toggle="modal" data-target="#leavingWarningModal">Leaving Warning</a>
<div data-controller="leaving-modal">
  <div class="modal" id="leavingWarningModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
      <div class="container py-3 px-3 modal-content px-0">
        <div class="modal-header d-flex align-items-center border-0 p-0">
          <div class="col-auto p-0">
            <div class="warning-icon icon icon-sm" alt="warning" aria-hidden="true">&nbsp;</div>
          </div>
          <div class="col p-0 bold">
            <%= l10n('insured.leaving_modal.warning') %>
          </div>
          <div class="col-auto p-0">
            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
              <div class="close-icon icon-min align-self-start m-0" aria-hidden="true">&nbsp;</div>
            </button>
          </div>
        </div>
        <div class="modal-body border-0 px-0">
          <%= l10n('insured.leaving_modal.warning_description') %>
        </div>
        <div class="d-flex align-items-center mt-4 justify-content-end">
          <a href="#" class="btn outline mr-2" data-dismiss="modal" data-target="leaving-modal.leavingApplicationButton"><%= l10n('insured.leaving_modal.leave_without_submitting') %></a>
          <button type="button" class="btn-primary" data-dismiss="modal"><%= l10n('insured.leaving_modal.return_to_application') %></button>
        </div>
      </div>
    </div>
  </div>
</div>