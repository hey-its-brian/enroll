<% content_for(:nav_width) { "2" } %>
<% content_for :side_nav do %>
  <% genesys_feature_enabled = EnrollRegistry.feature_enabled?(:genesys_cloud_messenger) %>
  <nav class="portal-nav">
    <ul id="">
      <li>
        <a href="<%= main_app.family_account_path(tab: 'home') %>" class="<%= 'active' if action_name == "home"  %>" data-turbolinks=<%= !genesys_feature_enabled %>><%= l10n("layout.header.home") %></a>
      </li>
      <% if @person.has_consumer_role? && qhp_application_feature_enabled? %>
        <li>
          <% applications_active = action_name.in?(%w[help_paying_coverage]) || controller_name.in?(%w[applications sbm_applications applicants]) %>
          <%= h(link_to l10n("qhp_application.show.applications"), main_app.current_applications_insured_sbm_applications_path, class: "#{'active' if applications_active}", data: genesys_feature_enabled ? {turbolinks: false} : {}) %>
        </li>
      <% end %>
      <% if EnrollRegistry.feature_enabled?(:enrollment_history_page) %>
        <li>
          <%= h(link_to l10n("enrollment_history_nav_label"), main_app.enrollment_history_insured_families_path, class: "#{'active' if action_name == 'enrollment_history'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) %>
        </li>
      <% end %>
      <% if (display_my_broker?(@person, @employee_role) && display_broker_info_for_consumer) && display_my_assister?(@person, @employee_role) %>
        <li>
          <%= h(link_to(main_app.brokers_insured_families_path(tab: l10n("brokers_assisters_tab")), class: "#{'active' if action_name == 'brokers'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <% page_title = has_assister_and_broker_roles?(@person) ? l10n('my_experts') : l10n('my_expert')%>
            <%= page_title %>
          <% end) %>
        </li>
        <% elsif  display_my_broker?(@person, @employee_role) && display_broker_info_for_consumer %>
        <li>
          <%= h(link_to(main_app.brokers_insured_families_path(tab: l10n("brokers_tab")), class: "#{'active' if action_name == 'brokers'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("my_broker") %>
          <% end) %>
        </li>
        <% elsif  display_my_assister?(@person, @employee_role) %>
        <li>
          <%= h(link_to(main_app.brokers_insured_families_path(tab: l10n("brokers_tab")), class: "#{'active' if action_name == 'brokers'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("my_broker") %>
          <% end) %>
        </li>
      <% end %>

      <% if display_documents_tab?(@family_members, @person) %>
        <li>
          <div class="d-flex">
            <%= h(link_to l10n("insured.families.verifications"), main_app.verification_insured_families_path(tab: 'verification'), class: "#{'active' if action_name == 'verification'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) %>
            <div role="alert" class="<%= 'hidden' unless enrollment_group_unverified?(@person) %> verifications-warning-icon icon d-inline-block mt-1" alt="warning" aria-hidden="true">&nbsp;</div>
          </div>
        </li>
      <% end %>
      <% if @person.has_consumer_role? && EnrollRegistry.feature_enabled?(:financial_assistance) && !qhp_application_feature_enabled? %>
        <li>
          <%= h(link_to(financial_assistance.applications_path(tab: 'cost_savings'), class: "#{'active' if ['index', 'index_with_filter', 'applications', 'review', 'raw_application'].include?(action_name)}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("faa.cost_savings_nav") %>
          <% end) %>
        </li>
      <% end %>
      <% unless qhp_application_feature_enabled? %>
        <li>
          <%= h(link_to(main_app.manage_family_insured_families_path(tab: 'family'), class: "#{'active' if ['personal', 'manage_family'].include?(action_name)}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("my_household") %>
          <% end) %>
        </li>
      <% end %>
      <% if current_user.has_hbx_staff_role? && has_active_resident_members?(@family_members) %>
        <li>
          <%= h(link_to(main_app.upload_application_insured_families_path(tab: 'verification'), class: "#{'active' if action_name == 'upload_application'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("upload_paper_application") %>
          <% end) %>
        </li>
      <% end %>
      <% if current_user.try(:has_hbx_staff_role?) && ivl_osse_enabled? && display_childcare_program_options(@person) %>
        <li>
          <%= h(link_to(main_app.healthcare_for_childcare_program_insured_families_path(tab: 'osse'), class: "#{'active' if action_name == 'healthcare_for_childcare_program'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("osse_eligibility") %>
          <% end) %>
        </li>
      <% end %>
      <li>
        <%= h(link_to(main_app.inbox_insured_families_path(tab: 'messages'), class: "#{'active' if action_name == 'inbox'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
          <%= l10n("messages") %>
          <span class="badge message-unread ml-half"><%= @person.inbox.unread_messages.size %></span>
        <% end) %>
      </li>
      <% if event_logging_enabled? && pundit_allow(HbxProfile, :can_view_audit_log?) %>
        <li>
          <%= h(link_to(main_app.event_logs_insured_families_path(tab: 'event_log_ivl'), class: "#{'active' if action_name == 'event_logs'}", data: genesys_feature_enabled ? {turbolinks: false} : {}) do %>
            <%= l10n("audit_log") %>
          <% end) %>
        </li>
      <% end %>
    </ul>
  </nav>
<% end %>
