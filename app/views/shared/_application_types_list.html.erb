<%= form_for @person.consumer_role, :url => insured_consumer_role_update_application_type_path(consumer_role_id: @person.consumer_role.id), method: :post do |f| %>
  <% if current_user.has_hbx_staff_role? %>
    <h2 class="mt-4" for="application_type_id"><%= l10n("application_type") %></h2>
    <div class="card mb-2">
      <label><%=l10n('choose_type')%></label>
      <div class="d-flex flex-column flex-md-row">
        <div class="form-group form-group-lg mr-2">
          <%= f.fields_for :family do |f| %>
            <%= f.select(:application_type, options_for_select(*consumer_role_application_type_options(@person)), required: true, id: 'application_type_id') %>
          <% end %>
        </div>
        <div class="form-group form-group-lg">
          <%= f.submit l10n('confirm_application_type'), class: 'btn btn-primary' %>
        </div>
      </div>
    </div>
  <% end %>
<% end %>
