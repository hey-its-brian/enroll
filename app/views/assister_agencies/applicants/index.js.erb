}
else {
  setTabContent("<%= escape_javascript render "shared/assisters/applicants_index", url: exchanges_assister_applicants_path, index_url: exchanges_assister_applicants_path(status: @status) %>")
  set_active_ontab("#assisters-tab");
  enableAssisterApplicantFilters();
}
