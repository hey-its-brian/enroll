var containing_row = $("#<%= @row %>").closest('TR');
var $parent_row = containing_row;
if ( $('tr.child-row:visible').length > 0 ) {
  $('tr.child-row:visible').remove();
  $("li>a:contains('Collapse Form')").addClass('disabled');
}
if ( $parent_row.next().hasClass('child-row') ) {} // Do Nothing
else {
  $parent_row.after('<tr class="child-row"><%= j render "datatables/terminate_enrollment", f: @family, formats: [:html] %></td></tr>');
  $("li>a:contains('Collapse Form')").eq(containing_row.index()).removeClass('disabled');
  $('.dropdown.pull-right').removeClass('open');
}

jQuery('[id^="terminate_hbx_"]').click(function($) {
  if (this.checked) {
    jQuery(jQuery(this).closest('tr').find('[type=checkbox]')[1]).prop('disabled', false);
  }
  else {
    jQuery(jQuery(this).closest('tr').find('[type=checkbox]')[1]).prop('disabled', true);
    jQuery(jQuery(this).closest('tr').find('[type=checkbox]')[1]).prop('checked', false);
  }
});

$( "[id^=edit_hbx_enrollment]" ).submit(function( event ) {
  if($('input[id^="termination_date_picker"]').val().length !=0)
        this.submit();
  else {
    event.preventDefault();
    alert("Please select a valid date.");
  }
});

