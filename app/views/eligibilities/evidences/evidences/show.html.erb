<%# Left Nav %>
<%= render partial: 'shared/family_side_nav' %>

<%# Main Content (right) %>
<% type_name = display_verification_type_name(@evidence_delegator.evidence_item_key) %>
<%= render partial: 'insured/families/verification_header', locals: {
  title: type_name,
  evidence: @evidence_delegator,
  member: @member,
  navigation: verification_navigation(@member, @evidence_delegator),
  summary_rows: [:member, :member_status, :status, :update_reason, :due_on],
  is_back_nav_primary: !display_upload_for_verification?(@evidence_delegator),
  display_application_id: true
} %>

<% if display_upload_for_verification?(@evidence_delegator) %>
  <section class="my-4" data-cuke='upload-documents'>
    <h2><%= l10n('insured.families.verifications.detail.verification_details') %></h2>

    <% if EnrollRegistry.feature_enabled?(:show_new_documents_types) %>
      <%= render partial: "insured/families/accepted_document_types", locals: { evidence: @evidence_delegator } %>
    <% else %>
      <div class="mb-4">
        <p><%= l10n('insured.verification_information_old') %></p>
        <% disable_list_flag = EnrollRegistry.feature_enabled?(:disable_documents_we_accept_list) %>
        <a aria-controls="docs-verification-faq" aria-expanded="false" data-toggle=<%= disable_list_flag ? "none" : "collapse" %>  href=<%= disable_list_flag ? ::EnrollRegistry[:enroll_app].setting(:submit_docs_url).item : "#docs-verification-faq" %> role="button" rel="noopener noreferrer" target=<%= "_blank" if disable_list_flag  %>>
          <%= l10n("insured.families.verification.documents_FAQ") %>
        </a>
        <div class="mt-2 collapse" id="docs-verification-faq">
          <%= render partial: "insured/families/verification/documents_verification_list" %>
        </div>
      </div>
    <% end %>
  </section>

  <section class="mb-4">
    <h2><%= l10n('insured.families.verifications.detail.document_upload') %></h2>
    <% query = verification_upload_query(@evidence_delegator, @family) %>
    <% attachable = false %>
    <%= form_tag query[:url], multipart: true, method: :post, :'data-controller' => ("file-manager" if attachable), :'data-action' => 'file-manager#submitForm' do %>
      <% query[:params].each do |name, value| %>
        <%= hidden_field_tag name, value %>
      <% end %>

      <% accepted_file_types = ::FileUploadValidator::VERIFICATION_DOC_TYPES %>
      <% human_readable_file_types = ::FileUploadValidator.human_readable_file_types(content_types: accepted_file_types, formatter: :to_sentence, pluralize: true) %>
      <p><%= l10n("insured.families.verifications.detail.document_upload.disclaimer", file_types: human_readable_file_types, max_size: ::FileUploadValidator::MAX_FILE_SIZE_MB) %></p>
      <div class='d-flex'>
        <% btn_class = qhp_application_feature_enabled? ? 'btn-primary' : 'btn-secondary'  %>
        <span tabindex="0" class="btn <%= btn_class %> btn-file text-nowrap mr-2" data-keydown-id="file-input" >
          <i class="fa fa-upload" aria-hidden="true"></i>
          <label>
            <%= l10n('upload_document') %>
            <%= file_field_tag "file[]", type: :file, accept: accepted_file_types.join(','), tabindex:"-1", :multiple => true, value: "Upload Documents", id: 'file-input', class: 'doc-upload-file', :'data-target' => "file-manager.fileInput", :'data-action' => "change->file-manager#accumulateAttachments" %>
          </label>
        </span>
        <% if attachable %>
          <button class="button primary" disabled="disabled" data-target="file-manager.uploadButton"><%= l10n('insured.families.verifications.detail.submit_document') %></button>
        <% end %>
      </div>

      <% if attachable %>
        <section class="d-flex mt-3">
          <dt class="col-auto px-0 mr-2"><%= l10n('insured.families.verifications.detail.uploaded_document')%>:</dt>
          <div class="col-auto px-0">
            <ul class="list-unstyled" data-target="file-manager.fileList">
              <li><%= l10n('none').downcase %></li>
            </ul>
          </div>
        </section>
      <% end %>
    <% end %>
  </section>
<% end %>

<section class="mb-4">
  <% if @evidence_delegator.documents&.present? || (qhp_application_feature_enabled? && @evidence_delegator.evidence_group != 'ridp') %>
    <h2><%= l10n('insured.families.verifications.detail.upload_history', verification_type: type_name) %></h2>
  <% end %>

  <% if qhp_application_feature_enabled? && @evidence_delegator.evidence_group != 'ridp' %>
    <p>
      <%= l10n('insured.families.verifications.detail.view_upload_history_text',
               history_button_text: content_tag(:strong, "'#{l10n('insured.families.verifications.detail.view_upload_history')}'")) %>
    </p>
  <% end %>

  <% if @evidence_delegator.documents&.present? %>
    <div class="mb-4">
      <table class="col-sm-12 col-md-8">
        <thead>
        <tr>
          <th class='col-7'><%= l10n('insured.families.verifications.detail.document.name') %></th>
          <th class='col-3'><%= l10n('insured.families.verifications.detail.document.submitted_on') %></th>
          <th class='col-2'><%= l10n('actions') %></th>
        </tr>
        </thead>
        <tbody>
        <% sorted_evidence_documents(@evidence_delegator).each do |document| %>
          <tr>
            <td class='col-7'><%= document.title.titleize %></td>
            <td class='col-3'><%= document.created_at %></td>
            <td class='col-2'>
              <% dropdowns = qhp_application_feature_enabled? ? qhp_enabled_verification_dropdowns(@evidence_delegator, document) : verification_dropdowns(@evidence_delegator, document)  %>
              <%= render partial: 'datatables/shared/dropdown', locals: {dropdowns: dropdowns} %>
            </td>
          </tr>
        <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <% if qhp_application_feature_enabled? && @evidence_delegator.evidence_group != 'ridp' %>
    <div class="d-flex justify-content-start">
      <%= link_to l10n('insured.families.verifications.detail.view_upload_history'), evidence_document_history_link(@evidence_delegator), class: 'btn btn-secondary' %>
    </div>
  <% end %>
</section>


<% admin_actions = admin_actions(@evidence_delegator, @member.person) %>
<% if current_user.has_hbx_staff_role? && admin_actions.values.any?(&:present?) %>
  <% can_view_history = admin_actions[:can_view_history] %>
  <% options = admin_actions[:options] %>
  <section>
    <h2 class="admin-designation"><%= l10n('insured.families.verifications.detail.admin_tools') %></h2>
    <% if options.present? %>
      <section class="mb-3">
        <% actions_hash = verification_admin_actions(@evidence_delegator, @family) %>
        <label class="v-type-actions">
          <%= l10n('action') %>
          <div><%= select_tag :verification_actions, options_for_select(options), {id: "v-action-#{actions_hash[:id]}", class: 'col-4', prompt: l10n("insured.consumer_roles.upload_ridp_documents.select_action")} %></div>
        </label>
        <%= render actions_hash[:partial] %>
      </section>
    <% end %>
    <% if can_view_history %>
      <section>
        <h2><%= l10n('verification_history') %></h2>
        <h3><%= l10n('applications') %></h3>
        <p><%= l10n('insured.evidences.select_application_year_text') %></p>
        <div class="d-flex align-items-center">
          <%= form_with url: nil, :method => :get, class: "col-2 mr-auto px-0",  data: { controller: "eligibility-history" } do %>
            <label>
              <div class="mb-1"><%= l10n('year')  %></div>
              <%= select("filter", "year", @years.each, {:selected => params.dig(:filter, :year)}, {class: "col", data: { action: "change->eligibility-history#submit" }})%>
            </label>
            <% params = evidence_params(@evidence_delegator) %>
            <%= hidden_field_tag :application_gid, params[:application_gid] %>
            <%= hidden_field_tag :applicant_id, params[:applicant_id] %>
            <%= hidden_field_tag :family_id, params[:family_id] %>
            <%= hidden_field_tag :person_id, params[:person_id] %>
            <%= hidden_field_tag :eligibility_kind, params[:eligibility_kind] %>
            <%= hidden_field_tag :evidence_key, params[:evidence_key] %>
          <% end %>
        </div>

        <div class="mb-4">
          <table class="col-sm-12">
            <thead>
            <tr>
              <th><%= l10n("application_id") %></th>
              <th><%= l10n('qhp_application.nav.application_type') %></th>
              <th><%= l10n('insured.sbm.applications.table.status') %></th>
              <th><%= l10n('insured.sbm.applications.table.started') %></th>
              <th><%= l10n('insured.sbm.applications.table.submission') %></th>
            </tr>
            </thead>
            <tbody>
            <% if @applications.present? %>
              <% @applications&.each do |application| %>
                <tr>
                  <% evidence = @application_evidence_mapping[application.hbx_id] %>
                  <td><%= link_to application.hbx_id, evidence_history_link(@evidence_delegator, evidence), class: 'primary-text' %></td>
                  <td><%= fetch_program_eligibility(application) %></td>
                  <td><%= application_state_for_display(application) %></td>
                  <td><%= to_est application.created_at %></td>
                  <td><%= format_submission_date(application) %></td>
                </tr>
              <% end %>
            <% else %>
            <tr>
              <td colspan="5"><%= l10n('insured.evidences.no_applications') %></td>
            </tr>
            <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  </section>
<% end %>

<script>
  $(document).ready(function() {
    Insured.custom_upload_init();
    displayAdminDesignationDescriptor();
  });
</script>
