<%= render partial: 'shared/family_side_nav' %>
<ul class="breadcrumbs mb-3">
  <li><%= l10n("insured.qhp_application.show.applications") %></li>
  <li><%= l10n("insured.qhp_application.show.application_details") %></li>
</ul>
<h1><%= @application.assistance_year %> <%= l10n("insured.qhp_application.show.application_details") %></h1>
<p><%= l10n("insured.qhp_application.show.application_details_description") %></p>

<% if current_user.has_hbx_staff_role? %>
  <aside class="mb-3" id="admin-designation-descriptor">
    <span class="admin-designation"></span>
    <%= l10n('admin.admin_designation_descriptor') %>
  </aside>
  <dl class="parent">
    <dt><%= l10n("application_id") %>:</dt>
    <dd><%= @application.id %></dd>
    <dt><%= l10n("insured.qhp_application.show.applied_for_fa") %>:</dt>
    <dd><%= l10n("no") %></dd>
    <dt><%= l10n("insured.qhp_application.origin") %>:</dt>
    <dd class="admin-designation"><%= @application.origin %></dd>
    <dt><%= l10n("insured.qhp_application.generation_reason") %>:</dt>
    <dd class="admin-designation"><%= @application.generation_reason %></dd>
  </dl>
<% end %>

<% primary_person = @application.primary_applicant %>
<%= render partial: 'insured/individual_market/applicants/summary', locals: {applicant: primary_person, internal_review: false} %>

<% @application.non_primary_applicants.each do |applicant| %>
  <%= render partial: 'insured/individual_market/applicants/summary', locals: {applicant: applicant, internal_review: false} %>
<% end %>

<!-- TODO: Correct link to add member to household -->
<div class="mt-3">
  <%= link_to l10n("insured.qhp_application.show.add_member"), insured_individual_market_application_applicants_path(@application, applicant: "new"), class: 'btn secondary' %>
</div>