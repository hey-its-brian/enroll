<%# Other Documents %>
<template id="other__with_alien_number__template" data-target="immigration-documents.template">
  <div class="document-fields">
    <%= render :partial => "insured/consumer_roles/docs_shared/alien_number", locals: {v: f, name: 'Passport'} %>
    <%= render :partial => "insured/consumer_roles/docs_shared/passport_number", locals: {v: f} %>
    <%= render :partial => "insured/consumer_roles/docs_shared/servis_id", locals: {v: f} %>
    <%= render :partial => "insured/consumer_roles/docs_shared/expiration_date", locals: {v: f, name: "Passport"} %>
    <%= render :partial => "insured/consumer_roles/docs_shared/country_of_citizenship", locals: {v: f} %>
    <div class="mt-4 mb-4">
      <%= f.label :description, l10n("insured.consumer_roles.docs_shared.document_description"), class: "weight-n" %>
      <%= f.text_field :description, :placeholder => l10n("insured.consumer_roles.docs_shared.document_description"),
                      :pattern => ".{1,35}",
                      :class => "doc_fields",
                      :title => l10n("insured.consumer_roles.docs_shared.document_description_req")%>
      <%= render :partial => "insured/consumer_roles/docs_shared/vlp_doc_requirements", locals: {req: l10n("insured.consumer_roles.docs_shared.document_description_req")} %>
    </div>
  </div>
</template>

