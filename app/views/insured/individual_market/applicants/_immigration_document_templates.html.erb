<%# Naturalization Documents %>
<template id="naturalization_certificate_template" data-target="immigration-documents.template">
  <div class="document-fields">
    <div class="form-group">
      <%= render :partial => "insured/consumer_roles/docs_shared/naturalization_number", locals: {v: f} %>
    </div>

    <div class="form-group">
      <%= render :partial => "insured/consumer_roles/docs_shared/alien_number", locals: {v: f, name: 'naturalization_certificate'} %>
    </div>
  </div>
</template>

