<%= image_pack_tag "icons/eye-off.svg",
                   class: "ssn-eye-off-#{presenter.applicant_id}",
                   alt: "view ssn icon",
                   tabindex: 0,
                   id: "eye-off-#{presenter.applicant_id}",
                   data: {
                     type: presenter.object_type,
                     id: presenter.applicant_id,
                     application_id: presenter.application_id,
                     action: "click->applicant#showSsn",
                     url: "/insured/individual_market/applications/#{presenter.application_id}/applicants/#{presenter.applicant_id}/show_ssn",
                     keydown_id: "eye-off-#{presenter.applicant_id}"
                   }
%>
<%= image_pack_tag "icons/eye-on.svg",
                   class: "hidden ssn-eye-on-#{presenter.applicant_id}",
                   alt: "hide ssn icon",
                   tabindex: 0,
                   id: "eye-on-#{presenter.applicant_id}",
                   data: {
                     id: presenter.applicant_id,
                     action: "click->applicant#hideSsn",
                     keydown_id: "eye-on-#{presenter.applicant_id}"
                   }
%>
