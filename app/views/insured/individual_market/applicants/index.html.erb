<%= render partial: 'shared/progress_side_nav', locals: {nav: individual_market_nav_options(1, @application, show_account_button: @family.eligibility_determination.present?  )} %>
<%= javascript_pack_tag 'benefit_sponsors', 'data-turbolinks-track': 'reload' %>
<h1><%= l10n("family_information") %></h1>
<h2><%= l10n("application_for_coverage", year: @application.assistance_year )%></h2>
<p><%= l10n('qhp_application.nav.family_info_details') %></p>

<div data-controller="qhp-application family-information">
  <div id="dependent_buttons" class="d-flex flex-column flex-md-row my-md-4 <%= pundit_class Family, :updateable?%> <%= 'hidden' if @family.active_family_members.empty? %>">
    <div class="dependent-buttons">
      <button type="button"
              class="button outline d-flex"
              data-action="qhp-application#addApplicant"
              data-target="qhp-application.AddApplicantButton"
              data-member-id="new"
              data-qhp-application-url-value="<%= new_insured_individual_market_application_applicant_path(@application) %>">
        <span class="add-button-icon secondary"></span>
        <span class="ml-2"><%= l10n("add_new_member_to_household") %></span>
      </button>
    </div>
  </div>

  <div id="primary-person" class="py-3">
    <% primary_applicant = @application.primary_applicant %>
    <div class="d-flex flex-row align-items-center">
      <h2 class="mb-0"><%= l10n('member') %> 1</h2>
    </div>
    <div data-target="qhp-application.ApplicantRow" data-member-id="<%= primary_applicant.reference_id %>">
      <div id="member-<%= primary_applicant.id %>-info-display" class="d-flex flex-row flex-wrap justify-content-between">
        <div>
          <label for="primary-name"><%= l10n("name")%></label>
          <input 
            id="primary-name"
            type="text" 
            value="<%= [
                primary_applicant.person_name.given_name,
                primary_applicant.person_name.middle_name,
                primary_applicant.person_name.family_name
              ].reject(&:blank?).join(' ') %>" 
            disabled
          >
        </div>
        <div>
          <label for="primary-age"><%= l10n("age")%></label>
          <input id="primary-age" type="text" value="<%= primary_applicant.age_on(TimeKeeper.date_of_record) %>" disabled >
        </div>
        <div>
          <label for="primary-gender"><%= l10n("gender")%></label>
          <input id="primary-gender" type="text" value="<%= "#{primary_applicant.demographics.gender&.humanize}" %>" disabled >
        </div>
        <div>
          <label for="primary-relation"><%= l10n("relationship")%></label>
          <input id="primary-relation" type="text" value="<%= l10n("self")&.humanize %>" disabled >
        </div>
      </div>

      <div class="mt-3 member-<%= primary_applicant.id %>-buttons">
        <button type="button"
                class="btn btn-secondary outline"
                data-action="qhp-application#editApplicant"
                data-member-id="<%= primary_applicant.reference_id %>"
                data-target="qhp-application.EditApplicantButton"
                data-cuke="edit-primary-applicant"
                data-qhp-application-url-value="<%= edit_insured_individual_market_application_applicant_path(@application, primary_applicant) %>">
          <%= l10n("edit_member") %>
        </button>
      </div>
    </div>

    <div class="append_consumer_info" data-target="qhp-application.EditApplicantForm" data-member-id="<%= primary_applicant.reference_id %>">
    </div>
  </div>

  <div id="dependent_ul">
    <% @application.non_primary_applicants.each_with_index do |dependent, index| %>
      <div id="add_member_list_<%= dependent.id %>" class="dependent_list py-3">
        <div id="add_info_<%= dependent.id %>">
          <div class="d-flex flex-row align-items-center">
            <h2 class="mb-0"><%= l10n('member') %> <%= index + 2 %></h2>
          </div>
          <div class="dependent_notice_div_<%= dependent.id%>"></div>
          <div data-target="qhp-application.ApplicantRow" data-member-id="<%= dependent.reference_id %>">
            <div id="member-<%= dependent.id %>-info-display" class="d-flex flex-row flex-wrap justify-content-between">
              <div>
                <label for="dependent-<%= dependent.id%>-name"><%= l10n("name")%></label>
                <input id="dependent-<%= dependent.id%>-name" type="text" value="<%= "#{dependent.person_name.given_name} #{dependent.person_name.middle_name} #{dependent.person_name.family_name}"%>" disabled >
              </div>
              <div>
                <label for="dependent-<%= dependent.id%>-age"><%= l10n("age")%></label>
                <input id="dependent-<%= dependent.id%>-age" type="text" value="<%= dependent.age_on(TimeKeeper.date_of_record) %>" disabled >
              </div>
              <div>
                <label for="dependent-<%= dependent.id%>-gender"><%= l10n("gender")%></label>
                <input id="dependent-<%= dependent.id%>-gender" type="text" value="<%= "#{dependent.demographics.gender.humanize}" %>" disabled >
              </div>
              <div>
                <label for="dependent-<%= dependent.id%>-relation"><%= l10n("relationship")%></label>
                <input id="dependent-<%= dependent.id%>-relation" type="text" value="<%= dependent.relationship&.titleize %>" disabled >
              </div>
            </div>

            <div class="mt-3 member-<%= dependent.id %>-buttons mb-3">
              <button type="button"
                      class="btn btn-secondary outline"
                      data-action="qhp-application#editApplicant"
                      data-member-id="<%= dependent.reference_id %>"
                      data-target="qhp-application.EditApplicantButton"
                      data-cuke="edit-dependent-applicant"
                      data-qhp-application-url-value="<%= edit_insured_individual_market_application_applicant_path(@application, dependent) %>">
                <%= l10n("edit_member") %>
              </button>
            </div>
          </div>
        </div>

        <div class="append_consumer_info" data-target="qhp-application.EditApplicantForm" data-member-id="<%= dependent.reference_id %>">
        </div>
      </div>
    <% end %>
  </div>

  <div data-target="qhp-application.NewApplicant" class="mt-4">
    <!-- new applicant forms will be rendered here -->
  </div>
</div>
<div class="mt-md-5">
  <%= render partial: "shared/progress_navigation_buttons", locals: { next_link: preferences_insured_individual_market_application_path(@application) } %>
</div>
<%= render partial: 'shared/leaving_modal' %>