<% if @bs4 %>
  <%= render partial: 'shared/family_side_nav' %>
  <h1><%= l10n("insured.families.verifications") %></h1>
  <p><%= l10n(EnrollRegistry.feature_enabled?(:show_new_documents_tab_text) ? 'insured.verification_information' : 'insured.verification_information_old') %></p>
  <% if EnrollRegistry.feature_enabled?(:show_new_verifications_household_summary) %>
    <% if @person && @subjects.present? && individual_market_is_enabled? %>
      
      <% items = @action_items.select { |item| can_display_type?(item) } %>
      <% item_count = items.count %>
      <% if items.present? %>
        <section data-cuke="action-items">
          <div class="d-flex flex-row align-items-center">
            <h2 class="mb-0"><%= l10n('insured.consumer_roles.upload_ridp_documents.action_items') %></h2>
             <%= render partial: "action_items_banner", locals: {item_count: item_count} %>
          </div>

          <div class="table-responsive mb-4">
          <table data-controller='navigateable-table' class="col-sm-12 col-md-8">
              <thead>
                <tr>
                  <th><%= l10n('member') %></th>
                  <th><%= l10n('type') %></th>
                  <th><%= l10n('status') %></th>
                  <th><%= l10n('due_date') %></th>
                </tr>
              </thead>
              <tbody>
                <% items.each do |item| %>
                  <% subject = item.eligibility_state.subject %>
                  <tr data-href=<%= verification_detail_insured_families_path(person_id: subject.person_id, eligibility_kind: item.eligibility_state.eligibility_item_key, evidence_key: item.evidence_item_key) %>>
                    <td><b><%= subject.person.full_name %></b></td>
                    <td><b><%= display_verification_type_name(item.evidence_item_key) %></b></td>
                    <td><b><%= show_v_type(item) %></b></td>
                    <td><b><%= item.due_on || l10n('not_applicable') %></b></td>
                  </tr>
                <% end %>
              </tbody>
            </table>
          </div>
        </section>
      <% end %>

      <section data-cuke="household-members">
        <h2 class="mb-0"><%= l10n('insured.consumer_roles.upload_ridp_documents.outstanding_header') %></h2>
        <div class="table-responsive">
          <table data-controller='navigateable-table' class="col-sm-12 col-md-8">
            <thead>
              <tr>
                <th><%= l10n('name') %></th>
                <th><%= l10n('hbx_id') %></th>
                <th><%= l10n('status') %></th>
                <th><%= l10n('insured.families.verifications.members.earliest_due_date') %></th>
              </tr>
            </thead>
            <tbody>
              <% @subjects.each do |subject| %>
                <!-- TODO: each row should be a link to the individual details -->
                <% documents_outstanding = subject.documents_outstanding? %>
                <tr data-href=<%= verification_individual_insured_families_path(person_id: subject.person_id) %>>
                  <td><%= strong_if(is_strong: documents_outstanding) do subject.person.full_name end %></td>
                  <td><%= strong_if(is_strong: documents_outstanding) do subject.person.hbx_id end %></td>
                  <td>
                    <% if documents_outstanding %>
                      <div class="d-flex align-items-center" data-cuke="unverified-member-icon">
                        <div class="warning-icon icon" alt="warning" aria-hidden="true">&nbsp;</div>
                        <div class="my-1 pl-0 pr-2">
                          <strong><%= l10n('insured.families.verifications.members.unverified') %></strong>
                        </div>
                      </div>
                    <% else %>
                      <%= l10n('insured.families.verifications.members.verified') %>
                    <% end %>
                  </td>
                  <td><%= strong_if(is_strong: documents_outstanding) do subject.earliest_due_date&.to_s || l10n('not_applicable') end %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </section>
    <% end %>
  <% else %>
    <div class="mb-4">
      <% disable_list_flag = EnrollRegistry.feature_enabled?(:disable_documents_we_accept_list) %>
      <a aria-controls="docs-verification-faq" aria-expanded="false" data-toggle=<%= disable_list_flag ? "none" : "collapse" %>  href=<%= disable_list_flag ? ::EnrollRegistry[:enroll_app].setting(:submit_docs_url).item : "#docs-verification-faq" %> role="button" rel="noopener noreferrer" target=<%= "_blank" if disable_list_flag  %>>
        <%= l10n("insured.families.verification.documents_FAQ") %>
      </a>
      <div class="mt-2 collapse" id="docs-verification-faq">
        <%= render partial: "insured/families/verification/documents_verification_list" %>
      </div>
    </div>
    <% if @person && @family_members.present? && individual_market_is_enabled? %>
      <%= render 'insured/families/verification/verification' %>
    <% end %>

    <% if EnrollRegistry.feature_enabled?(:financial_assistance) %>
      <%= render partial: "financial_assistance/applications/verifications/verification", locals: {family_id: @family.id} %>
    <% end %>
  <% end %>
<% else %>
  <% content_for :navigation do %>
      <%= render partial: 'ui-components/v1/navs/families_navigation' %>
  <% end %>
  <h1 class="darkblue no-buffer"><%= l10n("documents") %></h1>
  <% if EnrollRegistry.feature_enabled?(:show_new_documents_tab_text) %>
    <h4><%= l10n("insured.verification_information") %></h4>
  <% else %>
    <h4 class='starter'><%= l10n("insured.verification_information_old") %></h4>
  <% end %>
  <div class="documents-tab">
    <% if @person && @family_members.present? %>
        <% if individual_market_is_enabled? %>
          <%= render 'insured/families/verification/verification' %>
        <% end %>
    <% end %>

    <% if EnrollRegistry.feature_enabled?(:financial_assistance) %>
      <%= render partial: "financial_assistance/applications/verifications/verification", locals: {family_id: @family.id} %>
    <% end %>
  </div>
  &nbsp;
  <% if medicaid_tax_credits_link_is_enabled? %>
    <div>
      <%= render partial: "navigate_to_curam_for_documents", :locals => {display_text: l10n('insured.families.apply_for_medicaid_widget')} %>
    </div>
  <% end %>
<% end %>
