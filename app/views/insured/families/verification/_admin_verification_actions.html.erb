<% if @bs4 %>
  <div class="verification-update-reason" id=<%="#{person.id}-#{v_type.split.join('-')}"%>>
    <%= form_tag update_verification_type_documents_path, method: :put do %>
      <%= hidden_field_tag 'person_id', person.id  %>
      <%= hidden_field_tag 'verification_type', type_id %>
      <%= hidden_field_tag 'admin_action', 'verify' %>
      <%= hidden_field_tag 'family_member_id', f_member.id  %>
      <%= hidden_field_tag('family', f_member.family.id) %>       
      <div class='mb-2'>
        <label>
          <%= l10n('admin.verifications.verify_reason') %>
          <div class="col-md-4 px-0"><%= select_tag :verification_reason, options_for_select(::VlpDocument::VERIFICATION_REASONS), {prompt: ' Select Reason', required: true, class: 'col'}%></div>
        </label>
      </div>
      <div>
        <%= submit_tag "Confirm", class: "button v-type-confirm-button" %>
      </div>
    <% end %>
  </div>

  <div class="return-for-def-reason" id=<%="#{person.id}-#{v_type.split.join('-')}-return"%>>
    <%= form_tag update_verification_type_documents_path, method: :put do %>
      <%= hidden_field_tag 'person_id', person.id  %>
      <%= hidden_field_tag 'verification_type', type_id %>
      <%= hidden_field_tag 'admin_action', 'return_for_deficiency' %>
      <%= hidden_field_tag 'family_member_id', f_member.id  %>
      <%= hidden_field_tag('family', f_member.family.id) %>       
      <div class='mb-2'>
        <label>
          <%= l10n('admin.verifications.reject_reason') %>
          <div class="col-md-4 px-0"><%= select_tag :verification_reason, options_for_select(build_reject_reason_list(v_type)), {prompt: ' Select Reason', required: true, class: 'col'}%></div>
        </label>
      </div>
      <div>
        <%= submit_tag "Confirm", class: "button v-type-confirm-button" %>
      </div>
    <% end %>
  </div>

  <div class="fedhub-request" id=<%="#{person.id}-#{v_type.split.join('-')}-hub"%>>
    <p>
      <% if v_type == 'DC Residency' %>
          New request to the Local Residency will be sent.
      <% else %>
          New request to the Federal Hub will be sent.
      <% end %>
    </p>
    <%= form_tag fed_hub_request_documents_path, method: :post do %>
      <%= hidden_field_tag 'person_id', person.id  %>
      <%= hidden_field_tag 'verification_type', type_id %>
      <%= hidden_field_tag 'admin_action', 'hub_request' %>
      <%= hidden_field_tag('family', f_member.family.id) %>       
      <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
    <% end %>
  </div>

  <div class="extend-request" id=<%="#{person.id}-#{v_type.split.join('-')}-extend"%>>
    <% unless EnrollRegistry.feature_enabled?(:verification_due_on_options) %>
      <p><%= l10n('admin.verifications.extend.do_you_want_to_extend') %></p>
    <% end %>
    <%= form_tag extend_due_date_documents_path, method: :put do %>
      <%= hidden_field_tag 'family_member_id', f_member.id  %>
      <%= hidden_field_tag 'person_id', person.id  %>
      <%= hidden_field_tag 'verification_type', type_id %>
      <%= hidden_field_tag 'admin_action', 'extend' %>
      <%= hidden_field_tag('family', f_member.family.id) %>       
      <% if EnrollRegistry.feature_enabled?(:verification_due_on_options) %>
        <label class="my-3" id="due-on-options">
          <%= l10n('admin.verifications.extend.due_date_options') %>
          <%= select_tag :extension_period, options_for_select(admin_evidence_due_on_options(due_on)), prompt: l10n('admin.verifications.extend.due_date_options.select'), class: 'd-block col-5', required: true, allow_blank: false %>
        </label>
        <label id="manual-due-on" class="my-3 hidden">
          <%= l10n('admin.verifications.extend.due_date_options.enter_manual_date') %>
          <%= date_field_tag :due_on, date_field_value(due_on), min: date_field_value, required: true, disabled: true, class: 'd-block' %>
        </label>
      <% end %>
      <div class='d-flex'>
        <%= link_to l10n('cancel'), '#', class: "btn outline mr-2 v-type-confirm-button" %>
        <%= submit_tag l10n('confirm_selection'), class: "btn btn-default v-type-confirm-button" %>
      </div>
    <% end %>
  </div>
<% else %>
  <!-- ***** Verification reason ***** -->
  <div class="row">
    <div class="verification-update-reason col-md-12" id=<%="#{person.id}-#{v_type.split.join('-')}"%>>
      <div class="col-md-6">
        Provide verification reason:
      </div>
      <%= form_tag update_verification_type_documents_path, method: :put do %>
          <%= hidden_field_tag 'person_id', person.id  %>
          <%= hidden_field_tag 'verification_type', type_id %>
          <%= hidden_field_tag 'admin_action', 'verify' %>
          <%= hidden_field_tag 'family_member_id', f_member.id  %>
          <%= hidden_field_tag('family', f_member.family.id) %>       
          <div class="form-group col-md-3">
            <%= select_tag :verification_reason, options_for_select(::VlpDocument::VERIFICATION_REASONS), {prompt: ' Select Reason', required: true}%>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== verification reason ==== -->

  <!-- ***** Reject reason ***** -->
  <div class="row">
    <div class="return-for-def-reason col-md-12" id=<%="#{person.id}-#{v_type.split.join('-')}-return"%>>
      <div class="col-md-6">
        Reject reason:
      </div>
      <%= form_tag update_verification_type_documents_path, method: :put do %>
          <%= hidden_field_tag 'person_id', person.id  %>
          <%= hidden_field_tag 'verification_type', type_id %>
          <%= hidden_field_tag 'admin_action', 'return_for_deficiency' %>
          <%= hidden_field_tag 'family_member_id', f_member.id  %>
          <%= hidden_field_tag('family', f_member.family.id) %>       
          <div class="form-group col-md-3">
            <%= select_tag :verification_reason, options_for_select(build_reject_reason_list(v_type)), {prompt: ' Select Reason', required: true}%>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== reject reason ==== -->

  <!-- ***** FEDhub request ***** -->
  <div class="row">
    <div class="fedhub-request col-md-12" id=<%="#{person.id}-#{v_type.split.join('-')}-hub"%>>
      <div class="col-md-9">
        <% if v_type == 'DC Residency' %>
            <p>New request to the Local Residency will be sent.</p>
        <% else %>
            <p>New request to the Federal Hub will be sent.</p>
        <% end %>
      </div>
      <%= form_tag fed_hub_request_documents_path, method: :post do %>
          <%= hidden_field_tag 'person_id', person.id  %>
          <%= hidden_field_tag 'verification_type', type_id %>
          <%= hidden_field_tag 'admin_action', 'hub_request' %>
          <%= hidden_field_tag('family', f_member.family.id) %>                 
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== fedhub request ==== -->

  <!-- ***** Extend ***** -->
  <div class="row">
    <div class="extend-request col-md-12" id=<%="#{person.id}-#{v_type.split.join('-')}-extend"%>>
      <div class="col-md-6">
        <p>Do you want to Extend Due Date for verification type</p>
      </div>
      <%= form_tag extend_due_date_documents_path, method: :put do %>
          <%= hidden_field_tag 'family_member_id', f_member.id  %>
          <%= hidden_field_tag 'person_id', person.id  %>
          <%= hidden_field_tag 'verification_type', type_id %>
          <%= hidden_field_tag 'admin_action', 'extend' %>
          <%= hidden_field_tag('family', f_member.family.id) %>              
          <div class="col-md-3">
            <%= link_to "Cancel", verification_insured_families_path, class: "btn btn-default v-type-confirm-button" %>
          </div>
          <div class="col-md-3">
            <%= submit_tag "Confirm", class: "btn btn-default v-type-confirm-button" %>
          </div>
      <%end%>
    </div>
  </div>
  <!-- ==== Extend request ==== -->
<% end %>

<% unless EnrollRegistry.feature_enabled?(:show_new_verifications_household_summary) %>
    <!-- ***** View History ***** -->
    <div class="row">
      <div class="view-history col-md-12" id=<%="#{person.id}-#{v_type.split.join('-')}-history"%>>
        <div>
          <h5>Verification History</h5>
          <table class="table table-bordered table-hover table-responsive">
            <thead>
            <tr>
              <th scope="col">#</th>
              <th scope="col">Date</th>
              <th scope="col">Action</th>
              <th scope="col">Modifier</th>
              <th scope="col">Update Reason</th>
              <th scope="col">Details</th>
            </tr>
            </thead>
            <tbody>
            <% history.each_with_index do |record, index| %>
                <tr>
                  <th scope="row"><%= index + 1 %></th>
                  <td><%= record.created_at.in_time_zone('Eastern Time (US & Canada)') %></td>
                  <td><%= record.action.capitalize %></td>
                  <td><%= record.modifier %></td>
                  <td><%= record.update_reason %></td>
                  <td>
                    <% if record.event_request_record_id || record.event_response_record_id %>
                        <button type="button" data-toggle="modal" data-target=<%="#record_details_#{record.id}" %>>Payload</button>
                    <% end %>
                  </td>
                </tr>
                <div class="modal fade" id=<%="record_details_#{record.id}" %>  tabindex="-1" role="dialog" aria-hidden="true">
                  <div class="modal-dialog modal-lg" role="document">
                    <div class="modal-content">
                      <div class="modal-header">
                        <h4 class="modal-title"><%= "#{record.action.capitalize} payload" %></h4>
                        <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                          <span aria-hidden="true">&times;</span>
                        </button>
                      </div>
                      <div class="modal-body">
                        <%= request_response_details(person, record, v_type) %>
                      </div>
                      <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Close</button>
                      </div>
                    </div>
                  </div>
                </div>
            <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <!-- ==== view history ==== -->
  <% end %>