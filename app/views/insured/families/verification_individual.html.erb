<%# Left Nav %>
<%= render partial: 'shared/family_side_nav' %>

<%= render partial: 'verification_header', locals: {
    title: @member.full_name,
    summary_rows: [:member_status],
    is_back_nav_primary: !@family.eligibility_determination.subjects.by_person(@member.person_id).first&.documents_action_needed?
  } %>

<% if EnrollRegistry.feature_enabled?(:verifications_household_summary_text_update) %>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_1') %></p>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_2') %></p>
<% else %>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_old') %></p>
<% end %>

<% evidences = @evidences.select { |item| can_display_type?(item) } %>

<section data-cuke="individual-verifications">
  <div class="d-flex flex-row align-items-center">
    <h2 class="mb-0"><%= l10n("verifications") %></h2>
    <%= render partial: "action_items_banner", locals: {item_count: evidences.select { |evidence| evidence.is_action_needed? }.count } %>
  </div>

  <% is_admin = current_user.has_hbx_staff_role? %>
  <div class="table-responsive mb-4">
    <table data-controller='navigateable-table' class="<%= "col-sm-12 col-md-#{is_admin ? 10 : 8}" %>">
      <thead>
        <tr>
          <th><%= l10n('document_name') %></th>
          <th><%= l10n('status') %></th>
          <% if is_admin %>
            <th class="admin-designation"><%= l10n('active') %></th>
          <% end %>
          <th><%= l10n('due_date') %></th>
        </tr>
      </thead>
      <tbody>
        <% evidences.each do |evidence| %>
          <% is_action_needed = evidence.is_action_needed? %>
          <tr data-href=<%= verification_detail_insured_families_path(evidence.detail_params) %>>
            <td class="<%= 'admin-designation' if is_admin && !can_display_type?(evidence, is_admin: false) %>">
              <%= strong_if(is_strong: is_action_needed) do display_verification_type_name(evidence.evidence_item_key) end %>
            </td>
            <td>
              <% status = show_v_type(evidence) %>
              <% if is_action_needed %>
                <div class="d-flex align-items-center">
                  <div class="warning-icon icon" alt="warning" aria-hidden="true">&nbsp;</div>
                  <div class="my-1 pl-0 pr-2">
                    <strong><%= status %></strong>
                  </div>
                </div>
              <% else %>
                <%= status %>
              <% end %>
            </td>
            <% if is_admin %>
              <td><%= strong_if(is_strong: is_action_needed) do human_boolean(!evidence.inactive) end %></td>
            <% end %>
            <td><%= strong_if(is_strong: is_action_needed) do evidence.due_on&.to_s || l10n('not_applicable') end %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>

<script>
  $(document).ready(function() {
    displayAdminDesignationDescriptor();
  });
</script>
