<%# Left Nav %>
<%= render partial: 'shared/family_side_nav' %>

<%= render partial: 'verification_header', locals: {
    title: @member.full_name,
    summary_rows: [:member_status],
    is_back_nav_primary: !@family.eligibility_determination.subjects.by_person(@member.person_id).first&.documents_action_needed?
  } %>

<% if EnrollRegistry.feature_enabled?(:verifications_household_summary_text_update) %>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_1') %></p>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_2') %></p>
<% else %>
  <p><%= l10n('insured.families.verifications.individual.disclaimer_old') %></p>
<% end %>

<% inactive_evidences, active_evidences = @evidences.select { |item| can_display_type?(item) }.partition(&:inactive) %>

<section data-cuke="individual-verifications">
  <div class="d-flex flex-row align-items-center">
    <h2 class="mb-0"><%= l10n("insured.families.verifications") %></h2>
    <%= render partial: "action_items_banner", locals: {item_count: active_evidences.select { |evidence| evidence.is_action_needed? }.count } %>
  </div>
  <%= render partial: 'individual_verifications_table', locals: { evidences: active_evidences } %>
</section>

<% if current_user.has_hbx_staff_role? && inactive_evidences.present? %>
  <section data-cuke="individual-inactive-verifications">
    <h2 class="admin-designation mb-0"><%= l10n("insured.families.verifications.individual.inactive_verifications") %></h2>
    <%= render partial: 'individual_verifications_table', locals: { evidences: inactive_evidences } %>
  </section>
<% end %>

<script>
  $(document).ready(function() {
    displayAdminDesignationDescriptor();
  });
</script>
