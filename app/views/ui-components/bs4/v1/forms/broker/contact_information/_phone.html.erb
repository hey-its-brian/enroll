<div class="row">
  <%= f.hidden_field :kind, value: 'work', id: "phoneType" %>
  <div class="col-md-3 mb-3">
    <% phone_error = l10n('phone_number.error') %>
    <%= f.label :full_number_without_extension, l10n("phone_number"), class: "required" %>
    <%= f.text_field :full_number_without_extension,
      placeholder: "(000) 000-0000",
      required: true,
      class: 'form-control phone_number',
      minlength: '14',
      maxlength: '14',
      value: determine_phone_number(f.object),
      data: { :"error-message" => phone_error, phone_number: true }
    %>
    <div class="invalid-feedback">
      <%= phone_error %>
    </div>
  </div>
  <% unless EnrollRegistry[:enroll_app].setting(:site_key).item.to_s == "dc" %>
    <div class="col-md-3 mb-3">
      <%= f.label :extension, l10n('phone_number.extension') %>
      <%= f.text_field :extension, class: 'form-control', maxlength: '10' %>
    </div>
  <% end %>
</div>

<script>
  $(document).ready(function() {
    $.inputMasks();

    $(document).on('input', '.phone_number', function() {
      var phoneValue = $(this).val().replace(/\D/g, '');
      var $input = $(this);

      if (phoneValue.length > 0 && phoneValue.charAt(0) === '0') {
        $input.val($input.val().replace(/^0+/, ''));
        $input.addClass('is-invalid');
        if (!$input.next('.invalid-feedback').length) {
          $input.after('<div class="invalid-feedback">Phone numbers cannot begin with a 0. Please check the number you entered, remove any leading zeros, and resubmit.</div>');
        }
      } else {
        $input.removeClass('is-invalid');
        $input.next('.invalid-feedback').remove();
      }
    });

    $(document).on('blur', '.phone_number', function() {
      var phoneValue = $(this).val().replace(/\D/g, '');
      var $input = $(this);

      if (phoneValue.length > 0 && phoneValue.charAt(0) === '0') {
        $input.addClass('is-invalid');
        if (!$input.next('.invalid-feedback').length) {
          $input.after('<div class="invalid-feedback">Phone numbers cannot begin with a 0. Please check the number you entered, remove any leading zeros, and resubmit.</div>');
        }
      }
    });
  });
</script>
