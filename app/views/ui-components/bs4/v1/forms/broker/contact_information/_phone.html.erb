<div class="row">
  <%= f.hidden_field :kind, value: 'work', id: "phoneType" %>
  <div class="col-md-3 mb-3">
    <% phone_error = l10n('phone_number.error') %>
    <%= f.label :full_number_without_extension, l10n("phone_number"), class: "required" %>
    <%= f.text_field :full_number_without_extension,
      placeholder: "(000) 000-0000",
      inputmode: 'numeric',
      type: 'text',
      class: 'form-control phone_number',
      maxlength: '14',
      value: determine_phone_number(f.object),
      data: { :"error-message" => phone_error } %>
    <div class="invalid-feedback d-none">
      <%= phone_error %>
    </div>
  </div>
  <% unless EnrollRegistry[:enroll_app].setting(:site_key).item.to_s == "dc" %>
    <div class="col-md-3 mb-3">
      <%= f.label :extension, l10n('phone_number.extension') %>
      <%= f.text_field :extension, class: 'form-control', maxlength: '10' %>
    </div>
  <% end %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    $.inputMasks(); // Optional – remove if interfering

    function validatePhoneNumber($input) {
      const raw = $input.val().replace(/\D/g, '');
      const errorMessage = "Phone numbers cannot begin with a 0. Please check the number you entered, remove any leading zeros, and resubmit.";

      $input.removeClass('is-invalid');
      $input.nextAll('.invalid-feedback').addClass('d-none').text('');

      if (raw.length > 0 && raw.charAt(0) === '0') {
        $input.addClass('is-invalid');
        $input[0].setCustomValidity(errorMessage);
        $input.nextAll('.invalid-feedback').text(errorMessage).removeClass('d-none');
      } else {
        $input[0].setCustomValidity('');
      }
    }

    $(document).on('input blur', '.phone_number', function() {
      validatePhoneNumber($(this));
    });

    // Prevent browser tooltip popup
    document.querySelectorAll('input.phone_number').forEach(input => {
      input.addEventListener('invalid', function(e) {
        e.preventDefault();
      });
    });

    // Prevent form submission if phone number is invalid
    $('form').on('submit', function(e) {
      const $phoneInput = $(this).find('.phone_number');
      validatePhoneNumber($phoneInput);
      if (!$phoneInput[0].checkValidity()) {
        e.preventDefault();
        $phoneInput[0].reportValidity();
      }
    });
  });
</script>
